<div class="max-w-2xl mx-auto px-4 py-8 space-y-6">
  <h1 class="text-2xl font-bold">비회원 주문서</h1>
  <% if @errors.present? %>
    <div role="alert" class="border border-black p-4"><%= @errors.join(" / ") %></div>
  <% end %>
  <ul class="border border-gray-300 divide-y divide-gray-200">
    <% @cart.items.each do |item| %>
      <li class="p-4 flex justify-between gap-4 text-sm">
        <span class="min-w-0"><span class="font-bold"><%= item.product.name %></span><br><%= item.variant.color %> / <%= item.variant.size %> · <%= item.quantity %>개</span>
        <span class="shrink-0 font-bold"><%= number_to_currency(item.line_total, unit: "", precision: 0) %>원</span>
      </li>
    <% end %>
  </ul>
  <p class="font-bold">주문 합계 <%= number_to_currency(@cart.total, unit: "", precision: 0) %>원</p>
  <%= form_with scope: :checkout, url: checkout_path, class: "space-y-4" do |f| %>
    <% { recipient_name: "받는 분", phone: "휴대폰", postal_code: "우편번호", address1: "주소", address2: "상세주소", birth_year: "출생연도(선택)" }.each do |field, label| %>
      <div>
        <%= f.label field, label, class: "block text-sm font-bold mb-2" %>
        <%= f.text_field field, value: @checkout[field.to_s], required: ![:address2, :birth_year].include?(field), class: "w-full min-w-0 border border-gray-400 p-3", inputmode: [:phone, :postal_code, :birth_year].include?(field) ? "numeric" : "text" %>
      </div>
    <% end %>
    <p class="text-sm text-gray-600">출생연도는 익명 취향분석용이며 입력하지 않아도 주문할 수 있습니다.</p>
    <div class="flex items-start gap-2">
      <%= f.check_box :privacy_consent, checked: @checkout["privacy_consent"] == "1", class: "mt-1 shrink-0" %>
      <%= f.label :privacy_consent, "개인정보 수집·이용 동의(배송 목적. 다음 주문용 저장 주소는 배송 완료 #{Rails.configuration.x.shipping_address_retention_days}일 뒤 파기, 주문 기록의 배송 정보는 전자상거래법에 따라 #{Rails.configuration.x.order_record_retention_years}년 보관 뒤 파기)", class: "text-sm leading-relaxed" %>
    </div>
    <%= link_to "개인정보처리방침 보기", privacy_policy_path, target: "_blank", rel: "noopener", class: "inline-block text-sm underline" %>
    <% instruction = PaymentInstruction.new %>
    <p class="text-sm text-gray-600" data-testid="checkout-payment-note">
      <% if instruction.ready? %>
        결제는 주문 후 계좌이체로 진행됩니다(주문 완료 화면에서 입금 계좌 안내)
      <% else %>
        결제는 주문 후 계좌이체로 진행됩니다. 입금 계좌는 준비 중이며, 준비되면 주문조회(주문서 번호 + 휴대폰 뒤 4자리)에서 확인하실 수 있습니다.
      <% end %>
    </p>
    <% business = BusinessInfo.new %>
    <section class="border border-gray-300 p-4 space-y-3 text-sm leading-relaxed" aria-label="주문 전 확인">
      <h2 class="font-bold">주문 전 확인</h2>
      <p>청약철회: 상품 수령 후 7일 이내에 판매자 연락처로 요청할 수 있습니다. 택 제거·착용으로 상품 가치가 크게 줄어든 경우에는 청약철회가 제한될 수 있습니다. 내용 확인을 위한 포장 훼손만으로 제한하지 않습니다.</p>
      <p>표시·광고 또는 계약과 다른 상품은 수령 후 3개월 이내이면서 그 사실을 안 날 또는 알 수 있었던 날부터 30일 이내에 청약철회를 요청할 수 있습니다.</p>
      <p>환불: 반품 도착 후 3영업일 이내에 입금 계좌로 환급합니다. 단순 변심 반품 배송비는 고객 부담이며, 상품 하자·오배송은 판매자 부담입니다.</p>
      <p>미성년자가 법정대리인 동의 없이 체결한 계약은 미성년자 또는 법정대리인이 취소할 수 있습니다.</p>
      <p>판매자 상호: <%= business.name || "등록 준비 중" %> · 전화: <%= business.phone || "등록 준비 중" %> · 이메일: <%= business.email || "등록 준비 중" %></p>
      <nav class="flex flex-wrap gap-4" aria-label="주문 관련 정책">
        <%= link_to "배송·반품 안내", returns_policy_path, class: "underline" %>
        <%= link_to "이용약관", terms_policy_path, class: "underline" %>
        <%= link_to "개인정보처리방침", privacy_policy_path, class: "underline" %>
      </nav>
    </section>
    <%= f.submit "주문하기", class: "w-full bg-black text-white p-4 font-bold" %>
  <% end %>
</div>

<% cache([ "product-card-v5", product, product.variants.map(&:updated_at).max&.to_i, product.worn_character&.updated_at&.to_i, local_assigns[:show_category] ], expires_in: 10.minutes) do %>
<div class="group block relative">

  <%# 상품 이미지 영역 %>
  <div class="relative w-full aspect-[2/3] bg-placeholder overflow-hidden">
    <%= link_to product_path(product), tabindex: -1, class: "block w-full h-full" do %>
      <% if (image_source = product_image_source(product)) %>
        <%# 브라우저 기본 지연 로딩(스크롤로 보일 때 로드) %>
        <img
          src="<%= image_source.is_a?(String) ? image_source : url_for(image_source) %>"
          alt="<%= product.name %>"
          class="w-full h-full object-cover"
          loading="lazy" decoding="async">
        <% if (hover_image = product.gallery_image_urls.second) %>
          <img src="<%= hover_image %>" alt="" aria-hidden="true" loading="lazy" decoding="async"
               class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out">
        <% end %>
      <% else %>
        <div class="w-full h-full flex flex-col items-center justify-center text-caption text-ink-3">
          <span>이미지 준비 중</span>
        </div>
      <% end %>

    <% end %>

    <%# 찜 버튼 (Stimulus 컨트롤러 연결) %>
    <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 focus-within:opacity-100 [@media(hover:none)]:opacity-100"
         data-controller="wishlist"
         data-wishlist-product-id-value="<%= product.id %>"
         data-action="click->wishlist#toggle">
      <button type="button"
              data-wishlist-target="button"
              aria-label="찜하기"
              aria-pressed="false"
              class="w-8 h-8 bg-transparent flex items-center justify-center text-ink">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.25"
             stroke="currentColor"
             class="w-5 h-5"
             data-wishlist-target="icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mt-3 text-left">
    <h3><%= link_to product.name, product_path(product), class: "text-ui font-medium text-ink line-clamp-2" %></h3>
    <p class="mt-1">
      <% if discount_rate(product) > 0 %>
        <%= price_won(discounted_price(product), sale: true) %>
        <s class="ml-2 text-caption text-ink-3 [&_.price]:text-caption [&_.price]:text-ink-3"><%= price_won(product.price) %></s>
      <% else %>
        <%= price_won(product.price) %>
      <% end %>
    </p>
    <% if product.sold_out? %>
      <span class="text-caption text-ink-3">품절</span>
    <% end %>
    <% if local_assigns[:show_category] && (category_label = product_category_label(product)) %>
      <span class="text-caption text-ink-3"><%= category_label %></span>
    <% end %>
    <% if (colors = product.color_names).size > 1 %>
      <p class="mt-1 text-caption text-ink-3"><%= colors.size %>가지 색상</p>
    <% end %>
  </div>
</div>
<% end %>

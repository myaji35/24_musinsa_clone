<% if @supplier_import.status.in?(%w[pending processing]) %><meta http-equiv="refresh" content="5"><% end %>
<div class="max-w-5xl mx-auto p-6">
  <div class="flex items-center justify-between mb-6"><h1 class="text-2xl font-bold text-gray-900">상품 입고 결과</h1><div class="flex gap-4"><%= link_to "이 가져오기 상품 분석하기", product_analyses_path(supplier_import_id: @supplier_import.id), class: "text-sm underline" %><%= link_to "목록", supplier_imports_path, class: "text-sm underline" %></div></div>
  <div class="border border-gray-200 rounded-lg bg-white p-5 mb-6">
    <p class="mb-3"><%= @supplier_import.file.filename %> · <%= @supplier_import.supplier&.name || "공급사 미선택" %></p>
    <span class="inline-block rounded-full px-2 py-1 text-xs font-semibold text-white <%= @supplier_import.status == 'done' ? 'bg-green-700' : @supplier_import.status == 'failed' ? 'bg-red-700' : 'bg-gray-700' %>"><%= @supplier_import.status %></span>
    <% if @supplier_import.status.in?(%w[pending failed]) %>
      <%= button_to retry_supplier_import_path(@supplier_import), class: "mt-4 inline-flex items-center gap-2 rounded bg-black px-4 py-2 text-sm text-white" do %>
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-5h5"/></svg>
        다시 처리
      <% end %>
    <% end %>
    <div class="mt-4 text-sm">전체 <%= @supplier_import.total_rows %> · 등록 <%= @supplier_import.imported_rows %> · 갱신 <%= @supplier_import.updated_rows %> · 실패 <%= @supplier_import.failed_rows %></div>
    <% if @supplier_import.error_message.present? %><p class="mt-3 text-sm text-red-700"><%= @supplier_import.error_message %></p><% end %>
  </div>
  <div class="border border-gray-200 rounded-lg overflow-hidden bg-white"><table class="w-full text-sm text-left"><thead class="bg-gray-50 text-gray-600"><tr><th class="p-3">행</th><th class="p-3">상태</th><th class="p-3">상품 ID</th><th class="p-3">메시지</th></tr></thead><tbody><% Array(@supplier_import.row_results).each do |result| %><tr class="border-t border-gray-200"><td class="p-3"><%= result["row"] %></td><td class="p-3"><span class="inline-block rounded-full px-2 py-1 text-xs font-semibold text-white <%= result['status'] == 'failed' ? 'bg-red-700' : 'bg-green-700' %>"><%= result["status"] %></span></td><td class="p-3"><%= result["product_id"] %></td><td class="p-3"><%= result["message"] %></td></tr><% end %></tbody></table></div>
</div>

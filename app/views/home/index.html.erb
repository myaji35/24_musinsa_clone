<% if params[:category].blank? && params[:q].blank? && params[:sort].blank? %>
  <%= render 'home/intro' %>
<% end %>

<div id="shop" class="max-w-[1600px] mx-auto px-4 md:px-8 py-6">
  <% if params[:q].present? && @ranked_products.empty? %>
    <%= render "products/search_empty", reset_path: root_path(request.query_parameters.except("q")) %>
  <% else %>
    <% if @stories.present? %>
      <%= render "home/category_grid" %>
      <% @stories.each do |story| %>
        <%= render "home/story", story: story %>
      <% end %>
    <% end %>

    <%# 랭킹 섹션 %>
    <div class="mt-16" id="ranking">
      <div class="flex items-center justify-between mb-4 border-b border-black pb-3">
          <h2 class="text-2xl font-bold text-black tracking-tight">JIEUM 랭킹</h2>
          <div class="text-xs text-gray-600 font-medium tabular-nums">
            <%= Time.current.strftime("%m.%d %H:00") %> 갱신
          </div>
      </div>

      <%# 카테고리 필터 %>
      <div class="flex flex-wrap gap-2 mb-8">
         <%= link_to "전체", root_path(q: params[:q], sort: params[:sort]), class: "px-3 py-1.5 text-xs font-bold border transition-all #{params[:category].blank? || params[:category] == '전체' ? 'bg-black text-white border-black' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-400 hover:text-black'}" %>

         <% shop_categories.map(&:first).each do |cat| %>
            <%= link_to cat, root_path(category: cat, q: params[:q], sort: params[:sort]), class: "px-3 py-1.5 text-xs font-medium border transition-all #{params[:category] == cat ? 'bg-black text-white border-black font-bold' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-400 hover:text-black'}" %>
         <% end %>
      </div>

      <%# 필터 & 검색 섹션 %>
      <%= render 'home/filter_section' %>

      <%# 상품 그리드 (ProductCard partial 사용) - Russian Doll Caching %>
      <% cache(["ranked-products-grid", @ranked_products.maximum(:updated_at), params[:category], params[:sort], params[:q]], expires_in: 10.minutes) do %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-2 gap-y-8 sm:gap-x-4">
          <% @ranked_products.each_with_index do |product, index| %>
            <div class="relative">
              <%# 랭킹 배지 오버레이 %>
              <div class="absolute top-0 left-0 z-10">
                  <div class="bg-black/90 text-white font-oswald text-lg px-2.5 py-1 leading-none font-bold">
                      <%= index + 1 %>
                  </div>
              </div>

              <%= render 'products/card', product: product %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

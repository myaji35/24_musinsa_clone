<div class="max-w-[720px] mx-auto px-gutter py-8 md:py-12 space-y-6">
  <p class="font-display text-eyebrow tracking-eyebrow uppercase">CHECKOUT</p>
  <h1 class="text-title font-semibold">비회원 주문서</h1>
  <% if @errors.present? %>
    <div role="alert" class="border border-sale text-sale px-4 py-3 text-body"><%= @errors.join(" / ") %></div>
  <% end %>
  <ul class="border-y border-line divide-y divide-hairline">
    <% @cart.items.each do |item| %>
      <li class="p-4 flex justify-between gap-4 text-ui">
        <span class="min-w-0"><span class="text-ui font-medium"><%= item.product.name %></span><br><%= item.variant.color %> / <%= item.variant.size %> · <%= item.quantity %>개</span>
        <span class="shrink-0"><%= price_won(item.line_total) %></span>
      </li>
    <% end %>
  </ul>
  <p class="flex justify-between border-t border-line pt-4 text-ui font-medium">주문 합계 <%= price_won(@cart.total, variant: :lg) %></p>
  <%= form_with scope: :checkout, url: checkout_path, class: "space-y-4" do |f| %>
    <% { recipient_name: "받는 분", phone: "휴대폰", postal_code: "우편번호", address1: "주소", address2: "상세주소", birth_year: "출생연도(선택)" }.each do |field, label| %>
      <div>
        <%= f.label field, label, class: "block text-ui font-medium mb-2" %>
        <%= f.text_field field, value: @checkout[field.to_s], required: ![:address2, :birth_year].include?(field), class: "field", inputmode: [:phone, :postal_code, :birth_year].include?(field) ? "numeric" : "text" %>
      </div>
    <% end %>
    <p class="text-caption text-ink-3">출생연도는 익명 취향분석용이며 입력하지 않아도 주문할 수 있습니다.</p>
    <div class="flex items-start gap-2">
      <%= f.check_box :privacy_consent, checked: @checkout["privacy_consent"] == "1", class: "mt-1 shrink-0" %>
      <%= f.label :privacy_consent, "개인정보 수집·이용 동의(배송 목적. 다음 주문용 저장 주소는 배송 완료 #{Rails.configuration.x.shipping_address_retention_days}일 뒤 파기, 주문 기록의 배송 정보는 전자상거래법에 따라 #{Rails.configuration.x.order_record_retention_years}년 보관 뒤 파기)", class: "text-body leading-relaxed" %>
    </div>
    <%= link_to "개인정보처리방침 보기", privacy_policy_path, target: "_blank", rel: "noopener", class: "inline-block btn-text text-caption" %>
    <% instruction = PaymentInstruction.new %>
    <p class="text-caption text-ink-3" data-testid="checkout-payment-note">
      <% if instruction.ready? %>
        결제는 주문 후 계좌이체로 진행됩니다(주문 완료 화면에서 입금 계좌 안내)
      <% else %>
        결제는 주문 후 계좌이체로 진행됩니다. 입금 계좌는 준비 중이며, 준비되면 주문조회(주문서 번호 + 휴대폰 뒤 4자리)에서 확인하실 수 있습니다.
      <% end %>
    </p>
    <%= f.submit "주문하기", class: "btn btn-primary w-full" %>
  <% end %>
</div>

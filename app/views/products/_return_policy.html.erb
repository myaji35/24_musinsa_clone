<%# 배송·반품 안내(config/policies/returns.yml) — 상세페이지와 반품 안내 페이지가 같은 내용을 쓴다 %>
<section aria-labelledby="return-policy" class="px-6 py-16 space-y-6 border-t border-hairline">
  <div class="text-center">
    <span class="block font-display text-caption tracking-eyebrow uppercase text-ink-3 mb-3">DELIVERY &amp; RETURN</span>
    <h2 id="return-policy" class="text-[20px] md:text-[22px] font-semibold leading-snug tracking-[-0.015em] text-ink">배송·반품 안내</h2>
    <p class="mt-3 text-body font-semibold text-ink"><%= policy["shipping"] %></p>
  </div>
  <dl class="space-y-4">
    <% policy["summary"].each do |item| %>
      <div class="p-4 bg-paper-2">
        <dt class="text-body font-semibold text-ink"><%= item["title"] %></dt>
        <dd class="mt-1 text-ui text-ink-2 leading-relaxed"><%= item["body"] %></dd>
      </div>
    <% end %>
  </dl>
  <div>
    <h3 class="text-body font-semibold text-ink">이런 경우 반품이 어려워요</h3>
    <ul class="mt-2 space-y-1.5 text-ui text-ink-2">
      <% policy["not_accepted"].each do |item| %><li class="flex gap-2"><span aria-hidden="true">·</span><%= item %></li><% end %>
    </ul>
    <p class="mt-2 text-caption text-ink-3">상품을 확인하기 위해 포장을 뜯은 것만으로는 반품이 거절되지 않습니다.</p>
  </div>
  <div>
    <h3 class="text-body font-semibold text-ink">반품 절차</h3>
    <ol class="mt-2 space-y-1.5 text-ui text-ink-2 list-decimal pl-5">
      <% policy["process"].each do |item| %><li><%= item %></li><% end %>
    </ol>
  </div>
</section>

<aside id="operator-feedback" class="fixed bottom-0 right-0 z-50 max-w-[calc(100vw-2rem)]" data-controller="operator-feedback" data-action="keydown.esc->operator-feedback#close" aria-label="운영자 의견">
  <aside id="operator-feedback-panel" hidden data-operator-feedback-target="panel" class="bg-paper text-ink border border-line shadow-lg p-4 mb-3 w-80 max-w-full max-h-[75dvh] overflow-y-auto" aria-labelledby="operator-feedback-title">
    <header class="flex items-center justify-between mb-3">
      <h2 id="operator-feedback-title" class="font-bold">의견 보내기</h2>
      <button type="button" data-action="operator-feedback#close" aria-label="의견 패널 닫기">닫기</button>
    </header>
    <%= form_with url: operator_feedbacks_path, scope: :feedback, data: { action: "submit->operator-feedback#submit", operator_feedback_target: "form" }, class: "space-y-3" do |f| %>
      <%= f.hidden_field :page_url, data: { operator_feedback_target: "pageUrl" } %>
      <p><%= f.label :kind, "종류", for: "operator-feedback-kind" %>
      <%= f.select :kind, Feedback::KINDS, {}, id: "operator-feedback-kind", class: "field w-full" %></p>
      <p><%= f.label :body, "내용", for: "operator-feedback-body" %>
      <%= f.text_area :body, id: "operator-feedback-body", required: true, minlength: 5, maxlength: 2000, rows: 4, class: "field w-full h-auto py-2", aria: { describedby: "operator-feedback-hint" } %>
      <small id="operator-feedback-hint">5자 이상 적어 주세요.</small></p>
      <p><%= f.label :manual_chapter, "매뉴얼 장 (선택)", for: "operator-feedback-chapter" %>
      <%= f.select :manual_chapter, Feedback::MANUAL_CHAPTERS, { include_blank: "선택 안 함" }, id: "operator-feedback-chapter", class: "field w-full" %></p>
      <%= f.submit "보내기", id: "operator-feedback-submit", class: "btn btn-primary w-full", data: { operator_feedback_target: "submit" } %>
    <% end %>
    <p aria-live="polite" data-operator-feedback-target="message" class="mt-3"></p>
  </aside>
  <button id="operator-feedback-toggle" type="button" class="btn btn-primary shadow-lg text-xs px-2 py-1" aria-controls="operator-feedback-panel" aria-expanded="false" data-operator-feedback-target="toggle" data-action="operator-feedback#toggle">의견 보내기</button>
</aside>

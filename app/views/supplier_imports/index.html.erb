<div class="max-w-5xl mx-auto p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">상품 입고 내역</h1>
    <%= link_to new_supplier_import_path, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-4 py-2.5 rounded-lg text-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg> 새 엑셀 업로드
    <% end %>
  </div>
  <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
    <table class="w-full text-sm text-left"><thead class="bg-gray-50 text-gray-600"><tr><th class="p-3">접수일</th><th class="p-3">공급사</th><th class="p-3">파일</th><th class="p-3">상태</th><th class="p-3">결과</th></tr></thead>
      <tbody><% @supplier_imports.each do |item| %><tr class="border-t border-gray-200"><td class="p-3"><%= seoul_datetime(item.created_at) %></td><td class="p-3"><%= item.supplier&.name || "미선택" %></td><td class="p-3"><%= link_to item.file.filename.to_s, supplier_import_path(item), class: "underline" %></td><td class="p-3"><span class="inline-block rounded-full px-2 py-1 text-xs font-semibold text-white <%= item.status == 'done' ? 'bg-green-700' : item.status == 'failed' ? 'bg-red-700' : 'bg-gray-700' %>"><%= item.status %></span></td><td class="p-3"><%= item.imported_rows + item.updated_rows %> / <%= item.total_rows %></td></tr><% end %></tbody>
    </table>
  </div>
</div>

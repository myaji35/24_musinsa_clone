<%# 배송·반품 안내(config/policies/returns.yml) — 상세페이지와 반품 안내 페이지가 같은 내용을 쓴다 %>
<section aria-labelledby="return-policy" class="px-6 py-16 space-y-6 border-t border-gray-200">
  <div class="text-center">
    <span class="block font-oswald text-xs tracking-[.3em] uppercase text-gray-500 mb-3">DELIVERY &amp; RETURN</span>
    <h2 id="return-policy" class="text-[26px] md:text-[32px] font-bold leading-tight tracking-[-0.025em] text-black">배송·반품 안내</h2>
    <p class="mt-3 text-[15px] font-bold text-black"><%= policy["shipping"] %></p>
  </div>
  <dl class="space-y-4">
    <% policy["summary"].each do |item| %>
      <div class="p-4 bg-gray-50">
        <dt class="text-[15px] font-bold text-black"><%= item["title"] %></dt>
        <dd class="mt-1 text-sm text-gray-700 leading-relaxed"><%= item["body"] %></dd>
      </div>
    <% end %>
  </dl>
  <div>
    <h3 class="text-[15px] font-bold text-black">이런 경우 반품이 어려워요</h3>
    <ul class="mt-2 space-y-1.5 text-sm text-gray-700">
      <% policy["not_accepted"].each do |item| %><li class="flex gap-2"><span aria-hidden="true">·</span><%= item %></li><% end %>
    </ul>
    <p class="mt-2 text-xs text-gray-600">상품을 확인하기 위해 포장을 뜯은 것만으로는 반품이 거절되지 않습니다.</p>
  </div>
  <div>
    <h3 class="text-[15px] font-bold text-black">반품 절차</h3>
    <ol class="mt-2 space-y-1.5 text-sm text-gray-700 list-decimal pl-5">
      <% policy["process"].each do |item| %><li><%= item %></li><% end %>
    </ol>
  </div>
</section>

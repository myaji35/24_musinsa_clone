<%# Epic 4.3: 지역별 트렌드 분석 페이지 %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <%# 헤더 %>
  <div class="mb-8">
    <%= link_to "← 대시보드", dashboard_index_path, class: "text-blue-600 hover:underline mb-2 inline-block" %>
    <h1 class="text-3xl font-bold mb-2">지역별 트렌드 분석</h1>
    <p class="text-gray-600">우편번호 앞 3자리 기반 프라이버시 보호형 지역 분석</p>
  </div>

  <%# 지역별 판매 순위 %>
  <div class="bg-white rounded-lg shadow border border-gray-200 mb-8">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-xl font-bold">지역별 판매 순위</h2>
      <p class="text-sm text-gray-600 mt-1">우편번호 앞 3자리로 추정되는 지역별 매출 및 주문 수</p>
    </div>

    <% if @regional_sales.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">순위</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">지역 코드</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">주문 수</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">총 매출</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">평균 주문액</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">매출 비중</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% total_sales = @regional_sales.sum { |r| r[:total_sales] } %>
            <% @regional_sales.each_with_index do |region, index| %>
              <% avg_order_value = region[:total_sales] / region[:order_count] %>
              <% sales_percentage = (region[:total_sales] / total_sales * 100).round(1) %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm">
                  <div class="w-8 h-8 rounded-full <%= index < 3 ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600' %> flex items-center justify-center font-bold">
                    <%= index + 1 %>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm font-mono font-medium"><%= region[:zip_prefix] %>xxx</td>
                <td class="px-6 py-4 text-sm"><%= number_with_delimiter(region[:order_count]) %>건</td>
                <td class="px-6 py-4 text-sm font-bold">₩<%= number_with_delimiter(region[:total_sales].to_i) %></td>
                <td class="px-6 py-4 text-sm text-gray-600">₩<%= number_with_delimiter(avg_order_value.to_i) %></td>
                <td class="px-6 py-4 text-sm">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 bg-gray-200 rounded-full h-2 max-w-[100px]">
                      <div class="bg-blue-600 h-2 rounded-full" style="width: <%= sales_percentage %>%"></div>
                    </div>
                    <span class="text-xs text-gray-600"><%= sales_percentage %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center text-gray-500">
        아직 지역별 판매 데이터가 없습니다.
      </div>
    <% end %>
  </div>

  <%# 지역별 취향 태그 %>
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-xl font-bold">지역별 취향 태그 Top 5</h2>
      <p class="text-sm text-gray-600 mt-1">각 지역에서 가장 인기 있는 취향 스타일</p>
    </div>

    <% if @regional_preferences.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
        <% @regional_preferences.each do |zip_prefix, tags| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
            <div class="font-mono font-bold text-lg mb-3 text-blue-600"><%= zip_prefix %>xxx 지역</div>
            <div class="space-y-2">
              <% tags.each_with_index do |(tag, count), index| %>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500"><%= index + 1 %>.</span>
                    <span class="text-sm font-medium"><%= tag %></span>
                  </div>
                  <span class="text-xs bg-blue-50 text-blue-600 px-2 py-1 rounded"><%= count %>회</span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center text-gray-500">
        아직 지역별 취향 데이터가 없습니다.
      </div>
    <% end %>
  </div>
</div>

<%# 29cm 스타일 상품 카드 컴포넌트 %>
<% cache("product-card-#{product.id}-#{product.updated_at.to_i}", expires_in: 10.minutes) do %>
<%= link_to product_path(product), class: "group block relative" do %>

  <%# 상품 이미지 영역 %>
  <div class="relative w-full aspect-[4/5] bg-gray-100 overflow-hidden mb-3">
    <% if (image_source = product_image_source(product)) %>
      <img
        data-src="<%= image_source.is_a?(String) ? image_source : url_for(image_source) %>"
        alt="<%= product.name %>"
        class="lazy w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy">
    <% else %>
      <div class="w-full h-full flex flex-col items-center justify-center text-gray-300 bg-gray-50">
        <span class="text-[10px] uppercase font-bold tracking-widest">No Image</span>
      </div>
    <% end %>

    <%# 찜 버튼 (Stimulus 컨트롤러 연결) %>
    <div class="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity"
         data-controller="wishlist"
         data-wishlist-product-id-value="<%= product.id %>"
         data-action="click->wishlist#toggle">
      <button type="button"
              data-wishlist-target="button"
              class="w-8 h-8 rounded-full bg-white/90 flex items-center justify-center shadow-sm text-gray-400 hover:text-red-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="2"
             stroke="currentColor"
             class="w-4 h-4"
             data-wishlist-target="icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
      </button>
    </div>
  </div>

  <%# 상품 정보 영역 %>
  <div class="px-1">
    <%# 브랜드명 %>
    <p class="text-[11px] font-bold text-black uppercase tracking-tight mb-1 truncate hover:underline hover:text-gray-600">
      <%= product.brand %>
    </p>

    <%# 상품명 %>
    <h3 class="text-[13px] text-gray-600 leading-tight mb-2 line-clamp-2 h-8 group-hover:text-black transition-colors">
      <%= product.name %>
    </h3>

    <%# 가격 및 메타 정보 %>
    <div class="flex items-end justify-between mt-auto">
      <div>
        <span class="font-bold text-[15px] text-black tracking-tight">
          <%= number_to_currency(product.price, unit: "", precision: 0) %>원
        </span>
        <% if discount_rate(product) > 0 %>
          <span class="block text-[11px] font-bold text-red-600 mt-0.5">
            <%= discount_rate(product) %>% SALE
          </span>
        <% end %>
      </div>

      <%# 구매수 및 평점 %>
      <div class="text-[10px] text-gray-400 font-medium text-right flex flex-col items-end">
        <span class="mb-0.5">구매 <%= number_to_human(product.sales_count || 0, format: "%n%u", units: { thousand: "k" }) %></span>
        <span class="flex items-center gap-0.5 text-gray-800 font-bold">
          <svg class="w-2.5 h-2.5 text-black fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          4.8
          <span class="text-gray-400 font-normal">(<%= product.reviews.length %>)</span>
        </span>
      </div>
    </div>

    <%# 배지 영역 (29cm 스타일) %>
    <div class="flex gap-1 mt-2">
      <% product_badges(product).each do |badge| %>
        <span class="<%= badge[:class] %>"><%= badge[:text] %></span>
      <% end %>
    </div>
  </div>
<% end %>
<% end %>

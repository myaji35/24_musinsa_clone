<% if params[:category].blank? && params[:q].blank? && params[:sort].blank? %>
  <%= render 'home/intro' %>
<% end %>

<div id="shop" class="px-gutter py-6">
  <% if params[:q].present? && @ranked_products.empty? %>
    <div class="text-center py-20" role="status">
      <h2 class="text-title font-semibold">검색 결과가 없습니다</h2>
      <p class="mt-2 text-body text-ink-2">“<%= params[:q] %>”에 해당하는 상품이 없습니다.</p>
      <p class="mt-1 text-body text-ink-2">다른 검색어를 입력하거나 검색을 초기화해보세요.</p>
      <%= link_to "검색 초기화", root_path(request.query_parameters.except("q")), class: "mt-6 btn btn-secondary" %>
    </div>
  <% else %>
    <% if @stories.present? %>
      <%= render "home/category_grid" %>
      <% @stories.each do |story| %>
        <%= render "home/story", story: story %>
      <% end %>
    <% end %>

    <%# 랭킹 섹션 %>
    <div class="mt-14 md:mt-20" id="ranking">
      <div class="flex items-center justify-between mb-4 border-b border-line pb-3">
          <div><p class="font-display text-eyebrow tracking-eyebrow uppercase text-ink-3">RANKING</p><h2 class="text-title font-semibold">JIEUM 랭킹</h2></div>
          <div class="text-caption text-ink-3 tabular-nums">
            <%= Time.current.strftime("%m.%d %H:00") %> 갱신
          </div>
      </div>

      <%# 카테고리 필터 %>
      <div class="flex flex-wrap gap-2 mb-8">
         <%= link_to "전체", root_path(q: params[:q], sort: params[:sort]), class: "chip #{params[:category].blank? || params[:category] == '전체' ? 'is-selected' : ''}" %>

         <% shop_categories.map(&:first).each do |cat| %>
            <%= link_to cat, root_path(category: cat, q: params[:q], sort: params[:sort]), class: "chip #{params[:category] == cat ? 'is-selected' : ''}" %>
         <% end %>
      </div>

      <%# 필터 & 검색 섹션 %>
      <div class="[&>div]:mb-6">
        <%= render 'home/filter_section' %>
      </div>

      <%# 상품 그리드 (ProductCard partial 사용) - Russian Doll Caching %>
      <% cache(["ranked-products-grid-v3", @ranked_products.maximum(:updated_at), params[:category], params[:sort], params[:q]], expires_in: 10.minutes) do %>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-2 md:gap-x-3 gap-y-7 md:gap-y-10">
          <% @ranked_products.each_with_index do |product, index| %>
            <div class="relative">
              <%# 랭킹 배지 오버레이 %>
              <div class="absolute top-0 left-0 z-10 w-6 h-6 grid place-items-center bg-ink text-inverse font-display text-caption">
                      <%= index + 1 %>
              </div>

              <%= render 'products/card', product: product %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

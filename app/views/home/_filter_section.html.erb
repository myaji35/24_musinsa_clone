<%# 29cm 스타일 필터 & 정렬 섹션 %>
<div class="mb-8">
  <%# 정렬 옵션 %>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-2">
      <span class="text-caption text-ink-3">정렬:</span>
      <div class="flex gap-2">
        <%= link_to "인기순", root_path(category: params[:category], q: params[:q], sort: nil),
            class: "chip #{params[:sort].blank? ? 'is-selected' : ''}" %>

        <%= link_to "최신순", root_path(category: params[:category], q: params[:q], sort: 'newest'),
            class: "chip #{params[:sort] == 'newest' ? 'is-selected' : ''}" %>

        <%= link_to "낮은가격", root_path(category: params[:category], q: params[:q], sort: 'price_low'),
            class: "chip #{params[:sort] == 'price_low' ? 'is-selected' : ''}" %>

        <%= link_to "높은가격", root_path(category: params[:category], q: params[:q], sort: 'price_high'),
            class: "chip #{params[:sort] == 'price_high' ? 'is-selected' : ''}" %>
      </div>
    </div>

    <%# 검색 결과 카운트 %>
    <div class="text-caption text-ink-3">
      총 <span class="font-medium text-ink"><%= @ranked_products.count %></span>개
    </div>
  </div>

  <%# 검색 바 (29cm 스타일) %>
  <div class="relative max-w-md">
    <%= form_with url: root_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.hidden_field :category, value: params[:category] %>
      <%= f.hidden_field :sort, value: params[:sort] %>

      <div class="relative flex-1">
        <%= f.text_field :q,
            value: params[:q],
            placeholder: "브랜드, 상품명 검색",
            class: "field pr-12" %>

        <%# 검색 아이콘 %>
        <button type="submit" aria-label="검색" class="absolute right-1 p-2 top-1/2 -translate-y-1/2 text-ink-3 hover:text-ink">
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>

      <% if params[:q].present? %>
        <%= link_to "초기화", root_path(category: params[:category], sort: params[:sort]),
            class: "btn btn-secondary h-chip px-3" %>
      <% end %>
    <% end %>
  </div>
</div>

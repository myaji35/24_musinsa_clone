<main class="container mx-auto px-4 py-8">
  <%= link_to "대화 목록", wechat_index_path, class: "underline" %>
  <h1 class="text-3xl font-bold mb-6"><%= @contact.display_name %></h1>
  <%= render "settings" %>
  <section class="border rounded-lg p-4 mb-6">
    <h2 class="text-xl font-bold">거래처 연결</h2>
    <%= form_with url: wechat_path(@contact), method: :patch do |form| %>
      <%= form.label :supplier_id, "거래처" %>
      <%= form.select :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, @contact.supplier_id), include_blank: "미연결" %>
      <%= form.submit "연결 저장", class: "border rounded p-2" %>
    <% end %>
  </section>
  <ol class="space-y-4 mb-6" aria-label="대화 내역">
    <% @messages.each do |message| %>
      <li class="border rounded-lg p-4">
        <p><%= message.direction == "in" ? "담당자" : "관리자" %> · <%= l message.created_at, format: :short %> · <%= message.msg_type %> · <%= message.status %></p>
        <p class="whitespace-pre-wrap"><%= message.content %></p>
        <% if message.media_id.present? %><p>미디어 ID: <%= message.media_id %></p><% end %>
        <% if message.error.present? %><p role="status"><%= message.error %></p><% end %>
      </li>
    <% end %>
  </ol>
  <% unless @contact.window_open? %><p role="status"><%= Wechat::Client::WINDOW_CLOSED %></p><% end %>
  <%= form_with url: send_message_wechat_path(@contact) do |form| %>
    <%= form.label :content, "메시지 (최대 2000자)" %>
    <%= form.text_area :content, maxlength: 2000, required: true, rows: 4, class: "block border rounded w-full p-2" %>
    <%= form.submit "위챗 보내기", class: "border rounded p-2 mt-2" %>
  <% end %>
</main>

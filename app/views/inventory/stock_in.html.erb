<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <%= link_to inventory_scan_path, class: "text-gray-500 hover:text-black" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900">입고 처리</h1>
    </div>
    <p class="text-sm text-gray-500">상품 입고 및 재고 증가</p>
  </div>

  <!-- Flash Messages -->
  <% if flash[:notice] %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!-- Variant Info (바코드 스캔 후 표시) -->
  <% if @variant %>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 mb-6">
      <h2 class="text-sm font-bold text-gray-700 mb-4">상품 정보</h2>
      <div class="space-y-2">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">상품명</span>
          <span class="text-sm font-medium text-gray-900"><%= @variant.product.name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">브랜드</span>
          <span class="text-sm font-medium text-gray-900"><%= @variant.product.brand %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">옵션</span>
          <span class="text-sm font-medium text-gray-900"><%= @variant.color %> / <%= @variant.size %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">바코드</span>
          <span class="text-sm font-mono text-gray-900"><%= @variant.barcode %></span>
        </div>
        <div class="flex justify-between pt-2 border-t">
          <span class="text-sm font-bold text-gray-700">현재 재고</span>
          <span class="text-lg font-bold text-black"><%= @variant.stock || 0 %>개</span>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Stock In Form -->
  <%= form_with(model: @stock_log, url: inventory_stock_in_path, method: :post, class: "space-y-6") do |form| %>
    <% if @stock_log.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h3 class="text-sm font-bold text-red-800 mb-2"><%= pluralize(@stock_log.errors.count, "error") %> 발생:</h3>
        <ul class="list-disc list-inside text-sm text-red-700">
          <% @stock_log.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :barcode, value: params[:barcode] %>

    <!-- 바코드 입력 (스캔하지 않은 경우) -->
    <% unless @variant %>
      <div>
        <%= form.label :barcode, "바코드 *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :barcode, required: true, autofocus: true, class: "w-full border border-gray-300 rounded-md px-4 py-3 text-lg font-mono focus:ring-black focus:border-black", placeholder: "바코드를 입력하거나 스캔하세요" %>
        <p class="text-xs text-gray-500 mt-1">카메라 스캔을 사용하려면 <%= link_to "스캔 페이지", inventory_scan_path, class: "text-blue-600 underline" %>로 이동하세요</p>
      </div>
    <% end %>

    <!-- 입고 수량 -->
    <div>
      <%= label_tag :quantity, "입고 수량 *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :quantity, required: true, min: 1, value: 1, class: "w-full border border-gray-300 rounded-md px-4 py-3 text-lg focus:ring-black focus:border-black" %>
    </div>

    <!-- 사입처 -->
    <div>
      <%= label_tag :supplier, "사입처", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :supplier, class: "w-full border border-gray-300 rounded-md px-4 py-3 focus:ring-black focus:border-black", placeholder: "예: 동대문 도매상" %>
    </div>

    <!-- 단가 -->
    <div>
      <%= label_tag :unit_cost, "사입 단가 (원)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :unit_cost, step: 0.01, class: "w-full border border-gray-300 rounded-md px-4 py-3 focus:ring-black focus:border-black", placeholder: "15000" %>
    </div>

    <!-- 메모 -->
    <div>
      <%= label_tag :note, "메모", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :note, rows: 3, class: "w-full border border-gray-300 rounded-md px-4 py-3 focus:ring-black focus:border-black", placeholder: "입고 관련 메모를 입력하세요" %>
    </div>

    <!-- 제출 버튼 -->
    <div class="flex gap-3">
      <%= form.submit "입고 처리", class: "flex-1 bg-black text-white font-bold py-4 rounded-md hover:bg-gray-800 transition-colors cursor-pointer" %>
      <%= link_to "취소", inventory_scan_path, class: "flex-1 bg-white border border-gray-300 text-black font-bold py-4 rounded-md hover:border-black transition-colors text-center" %>
    </div>
  <% end %>
</div>

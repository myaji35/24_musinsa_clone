<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.jieum.kakao-agent</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>/Users/YOUR_NAME/jieum-kakao/jieum_kakao_agent.py</string><string>run-once</string></array>
<key>StartInterval</key><integer>900</integer>
<key>StandardOutPath</key><string>/Users/YOUR_NAME/.jieum-kakao/agent.log</string>
<key>StandardErrorPath</key><string>/Users/YOUR_NAME/.jieum-kakao/agent-error.log</string>
</dict></plist>

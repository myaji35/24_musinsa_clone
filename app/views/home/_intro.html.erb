<% content_for :head do %>
<% end %>

<div class="intro" data-controller="scroll-scene">
  <section class="intro-section intro-runway" data-scroll-scene-target="section" style="--p: 0">
    <div class="intro-stage intro-runway-stage">
      <div class="intro-runway-perspective" aria-hidden="true">
        <span class="intro-wordmark intro-wordmark-back">JIEUN</span>
        <span class="intro-wordmark intro-wordmark-front">JIEUN</span>
      </div>
      <div class="intro-video-perspective">
        <div class="intro-video-frame">
          <video src="/intro/yuna-runway.mp4" poster="/intro/yuna-runway-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="유나의 런웨이 영상"></video>
          <span class="intro-ai-badge">AI 가상인물</span>
        </div>
      </div>
      <div class="intro-runway-copy">
        <h1>서른둘, 유나가 먼저 걸어봤어요</h1>
        <p>강유나 · 32 · Seoul</p>
      </div>
      <div class="intro-scroll-cue" aria-hidden="true">
        <span>스크롤</span>
        <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2"><path d="M12 3v17m-6-6 6 6 6-6" /></svg>
      </div>
    </div>
  </section>

  <section class="intro-section intro-characters" data-scroll-scene-target="section" style="--p: 0">
    <div class="intro-stage intro-characters-stage">
      <div class="intro-scene-heading">
        <span class="intro-eyebrow">THE CAST</span>
        <h2>20명의 캐릭터, 20개의 옷장</h2>
      </div>
      <% cache @intro_cache_key do %>
        <% intro_avatars = Avatar.all.index_by(&:handle) %>
        <div class="intro-ring-viewport">
          <div class="intro-ring">
            <% Character.for_intro.each_with_index do |character, index| %>
              <% avatar = intro_avatars[character.handle] %>
              <article class="intro-card intro-card-<%= character.age_band %>" style="--intro-index: <%= index %>">
                <span class="intro-card-band"><%= character.age_band %>s</span>
                <% if avatar %>
                  <%= image_tag avatar.card_image, class: "intro-card-photo", alt: "#{character.name} (AI 가상 인물)", loading: "lazy" %>
                  <span class="intro-card-virtual">가상 인물</span>
                <% else %>
                  <span class="intro-card-initial" aria-hidden="true"><%= character.handle.first %></span>
                <% end %>
                <div class="intro-card-details">
                  <span class="intro-card-romanized"><%= character.handle %></span>
                  <h3><%= character.name %></h3>
                  <p><%= character.age %> · <%= character.birthplace %></p>
                  <p><%= character.style_axis %></p>
                  <% unless avatar %><span class="intro-card-soon">곧 공개</span><% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="intro-section intro-tagline" data-scroll-scene-target="section" style="--p: 0">
    <div class="intro-stage intro-tagline-stage">
      <div class="intro-tagline-content">
        <h2><span style="--intro-order: 0">주소는</span> <span style="--intro-order: 1">지우고,</span> <span style="--intro-order: 2">취향은</span> <span style="--intro-order: 3">잇다.</span></h2>
        <p>20~50대, 나와 닮은 캐릭터가 먼저 입어봅니다.</p>
        <a href="#ranking" class="intro-cta">유나의 옷장 보기 <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
      </div>
    </div>
  </section>
</div>

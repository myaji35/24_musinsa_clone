<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">

  <% if logged_in? %>
    <div data-testid="publication-bar" class="flex flex-wrap items-center justify-between gap-3 p-4 mb-6 text-sm border <%= @product.published? ? 'border-gray-300 bg-white' : 'border-amber-400 bg-amber-50' %>">
      <p class="font-medium text-gray-900">
        <% if @product.published? %>
          공개 중 · 손님 화면에 보입니다<%= " (#{@product.published_at.strftime('%Y-%m-%d %H:%M')} 공개)" if @product.published_at %>
        <% else %>
          미리보기 · 비공개 — 손님에게는 보이지 않습니다. 컨펌 후 공개해 주세요.
        <% end %>
      </p>
      <div class="flex gap-2">
        <%= link_to "수정", edit_product_path(@product), class: "px-4 py-2 border border-gray-300 text-gray-800 hover:border-black" %>
        <% if @product.published? %>
          <%= button_to "비공개로 되돌리기", unpublish_product_path(@product), data: { turbo_confirm: "손님 화면에서 내립니다. 계속할까요?" }, class: "px-4 py-2 border border-black text-black hover:bg-gray-100" %>
        <% else %>
          <%= button_to "공개", publish_product_path(@product), data: { turbo_confirm: "이 상세페이지를 손님에게 공개합니다. 계속할까요?" }, class: "px-4 py-2 bg-black text-white font-bold hover:bg-gray-800" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if (character = @product.worn_character) %>
    <div class="border border-gray-300 bg-gray-50 p-4 mb-6 text-sm text-gray-800 leading-relaxed">
      이 상품의 착용 이미지·영상은 AI로 만든 가상 인물(<%= character.name %>)입니다. 실제 핏·색상은 아래 실측 사이즈와 실물 사진을 확인해 주세요.
    </div>
  <% end %>

  <!-- 상품 메인 섹션 -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 mb-20">

    <!-- 좌측: 이미지 갤러리 -->
    <% gallery = @product.runway_video.attached? ? [] : @product.gallery_image_urls %>
    <% if gallery.any? %>
    <div class="space-y-4" data-controller="gallery">
      <div class="w-full aspect-[3/4] bg-gray-100 overflow-hidden relative">
        <%= image_tag gallery.first, alt: "#{@product.name} 착용컷", class: "w-full h-full object-cover", data: { gallery_target: "main" } %>
        <% if character %>
          <span class="absolute top-3 left-3 z-10 bg-white text-black px-3 py-2 text-lg font-bold shadow" data-gallery-target="badge">가상 인물</span>
        <% end %>
      </div>
      <div class="grid grid-cols-5 gap-2" data-testid="product-gallery">
        <% gallery.each_with_index do |url, i| %>
          <% real = url.end_with?("/real.jpg") %>
          <% label = real ? "실물 사진" : (i.zero? ? "정면 착용컷" : "룩북 #{i}") %>
          <button type="button" class="relative aspect-[3/4] bg-gray-100 border-2 <%= i.zero? ? 'border-black' : 'border-transparent' %> hover:border-black transition-colors overflow-hidden"
                  data-gallery-target="thumb" data-action="gallery#show" data-src="<%= url %>" data-alt="<%= "#{@product.name} #{label}" %>" data-real="<%= real %>" aria-pressed="<%= i.zero? %>" aria-label="<%= label %> 보기">
            <%= image_tag url, alt: "", loading: "lazy", class: "w-full h-full object-cover" %>
            <% if real %><span class="absolute bottom-0 inset-x-0 bg-black/70 text-white text-[11px] font-bold py-0.5">실물</span><% end %>
          </button>
        <% end %>
      </div>
    </div>
    <% else %>
    <div class="space-y-4">
      <!-- 메인 이미지 -->
      <div class="w-full aspect-[3/4] bg-gray-100 overflow-hidden<%= ' relative' if character || @product.runway_video.attached? %>">
        <% if @product.runway_video.attached? %>
          <%= video_tag url_for(@product.runway_video), muted: true, autoplay: true, loop: true, playsinline: true, controls: true, poster: (url_for(product_image_source(@product)) if product_image_source(@product)), class: "w-full h-full object-cover" %>
        <% elsif (image_source = product_image_source(@product)) %>
          <%= image_tag image_source, alt: @product.name, class: "w-full h-full object-cover" %>
        <% else %>
          <div class="w-full h-full flex items-center justify-center text-gray-300">
            <span class="text-sm font-medium">이미지 없음</span>
          </div>
        <% end %>
        <% if character || @product.runway_video.attached? %>
          <span class="absolute top-3 left-3 z-10 bg-white text-black px-3 py-2 text-lg font-bold shadow">가상 인물</span>
        <% end %>
      </div>

      <!-- 썸네일 그리드 -->
      <div class="grid grid-cols-4 gap-2">
        <% 4.times do |i| %>
          <div class="aspect-[3/4] bg-gray-100 border-2 <%= i == 0 ? 'border-black' : 'border-transparent' %> cursor-pointer hover:border-black transition-colors overflow-hidden">
            <% if i == 0 && (image_source = product_image_source(@product)) %>
              <%= image_tag image_source, alt: @product.name, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="w-full h-full bg-gray-50"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <!-- 우측: 상품 정보 -->
    <div class="space-y-6">

      <!-- 브랜드 & 상품명 -->
      <div class="space-y-2">
        <p class="text-sm font-medium text-gray-500 uppercase"><%= @product.brand %></p>
        <h1 class="text-2xl md:text-3xl font-bold text-black leading-tight"><%= @product.name %></h1>
        <% if (hero = @product.detail_page&.dig("hero")) %>
          <p data-testid="detail-headline" class="pt-2 text-lg font-bold text-gray-900 leading-snug"><%= hero["headline"] %></p>
          <p class="text-sm text-gray-600 leading-relaxed"><%= hero["sub"] %></p>
        <% end %>
      </div>

      <% if character %>
        <p class="text-sm text-gray-700" data-worn-character>
          <%= link_to character.name, character_path(character.handle), class: "font-bold underline" %><%= " #{character.height_cm}cm" if character.height_cm.present? %><%= " · 상의 #{character.top_size}" if character.top_size.present? %><%= " / #{@product.worn_size} 착용" if @product.worn_size.present? %>
        </p>
      <% end %>

      <!-- 가격 -->
      <div class="space-y-1">
        <p class="text-3xl font-bold text-black"><%= number_to_currency(@product.price, unit: "", precision: 0) %>원</p>
      </div>

      <div class="h-px bg-gray-200"></div>

      <%= form_with url: cart_items_path, class: "space-y-4" do |f| %>
        <%= f.label :variant_id, "색상 / 사이즈", class: "block text-sm font-bold" %>
        <%= f.select :variant_id,
              @variants.map { |variant| [ "#{variant.color} / #{variant.size} #{variant.stock.to_i.positive? ? "(재고 #{variant.stock}개)" : "(품절)"}", variant.id, { disabled: !variant.stock.to_i.positive? } ] },
              { selected: @variants.find { |variant| variant.stock.to_i.positive? }&.id },
              class: "w-full border border-gray-400 p-3", disabled: @variants.empty? %>
        <%= f.label :quantity, "수량", class: "block text-sm font-bold" %>
        <%= f.number_field :quantity, value: 1, min: 1, max: 99, class: "w-24 border border-gray-400 p-3" %>
        <% if @variants.empty? %><p class="text-sm font-medium text-gray-700">옵션 준비 중</p><% end %>
        <div class="grid grid-cols-2 gap-3">
          <%= f.button "바로구매", name: "buy_now", value: "1", disabled: @variants.empty?, class: "p-4 border border-black font-bold disabled:opacity-40" %>
          <%= f.button "장바구니", disabled: @variants.empty?, class: "p-4 bg-black text-white font-bold disabled:opacity-40" %>
        </div>
      <% end %>

      <% unless @product.detail_page %>
      <!-- 상품 설명 -->
      <div class="pt-6 space-y-3">
        <p class="text-sm font-medium text-black">상품 설명</p>
        <p class="text-sm text-gray-600 leading-relaxed"><%= @product.description %></p>
      </div>
      <% end %>

    </div>
  </div>

  <%= render "detail_page", product: @product, page: @product.detail_page, pairings: @pairings if @product.detail_page %>

  <!-- 리뷰 섹션 -->
  <div class="border-t-2 border-gray-200 pt-12 mb-20">

    <!-- 리뷰 헤더 -->
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-black">
        리뷰
        <span class="text-gray-400">(<%= @reviews.count %>)</span>
      </h2>
      <div class="flex items-center gap-2">
        <div class="flex text-yellow-400">
          <% 5.times do %>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          <% end %>
        </div>
        <span class="text-lg font-bold text-black"><%= @average_rating.present? ? sprintf("%.1f", @average_rating) : "5.0" %></span>
      </div>
    </div>

    <% if logged_in? %>
      <%= form_with model: [@product, Review.new], class: "border border-black p-6 mb-8 space-y-4" do |form| %>
        <div>
          <%= form.label :rating, "별점", class: "block text-sm font-bold text-black mb-2" %>
          <%= form.select :rating, (1..5).map { |rating| ["#{rating}점", rating] }, {}, class: "border border-black px-3 py-2 text-sm", required: true %>
        </div>
        <div>
          <%= form.label :content, "리뷰 내용", class: "block text-sm font-bold text-black mb-2" %>
          <%= form.text_area :content, rows: 4, maxlength: 1000, required: true, class: "w-full border border-black px-3 py-2 text-sm" %>
        </div>
        <%= form.submit "리뷰 등록", class: "px-5 py-3 bg-black text-white text-sm font-bold hover:bg-gray-800 transition-colors cursor-pointer" %>
      <% end %>
    <% end %>

    <!-- 리뷰 카드 -->
    <div class="space-y-6">
      <% if @reviews.any? %>
        <% @reviews.each do |review| %>
          <div class="border-b border-gray-100 pb-6 last:border-b-0">

            <!-- 리뷰 헤더 -->
            <div class="flex items-start justify-between mb-3">
              <div class="space-y-1">
                <p class="text-sm font-bold text-black"><%= review.user.name %></p>
                <div class="flex items-center gap-1 text-yellow-400">
                  <% review.rating.times do %>
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% end %>
                  <% (5 - review.rating).times do %>
                    <svg class="w-4 h-4 fill-current text-gray-200" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
              <p class="text-xs text-gray-400"><%= review.created_at.strftime("%Y.%m.%d") %></p>
            </div>

            <!-- 리뷰 내용 -->
            <p class="text-sm text-gray-700 leading-relaxed mb-3"><%= review.content %></p>

            <!-- 리뷰 추가 정보 -->
            <div class="flex flex-wrap gap-2 text-xs text-gray-500">
              <% if review.height.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">키 <%= review.height %>cm</span>
              <% end %>
              <% if review.weight.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">몸무게 <%= review.weight %>kg</span>
              <% end %>
              <% if review.size_purchased.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">구매 사이즈 <%= review.size_purchased %></span>
              <% end %>
            </div>

            <!-- 리뷰 사진 -->
            <% if review.photo_url.present? %>
              <div class="mt-3">
                <img src="<%= review.photo_url %>" alt="리뷰 사진" class="w-32 h-32 object-cover border border-gray-200">
              </div>
            <% end %>

          </div>
        <% end %>
      <% else %>
        <div class="py-12 text-center">
          <p class="text-sm text-gray-400">아직 작성된 리뷰가 없습니다.</p>
        </div>
      <% end %>
    </div>

  </div>

  <!-- 연관 상품 섹션 -->
  <div class="border-t-2 border-gray-200 pt-12">

    <h2 class="text-xl md:text-2xl font-bold text-black mb-8">연관 상품</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      <% if @related_products.present? %>
        <% @related_products.take(4).each do |product| %>
          <a href="<%= product_path(product) %>" class="group space-y-3">

            <!-- 상품 이미지 -->
            <div class="w-full aspect-[3/4] bg-gray-100 overflow-hidden">
              <% if (image_source = product_image_source(product)) %>
                <%= image_tag image_source, alt: product.name, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <span class="text-xs">이미지 없음</span>
                </div>
              <% end %>
            </div>

            <!-- 상품 정보 -->
            <div class="space-y-1">
              <p class="text-xs text-gray-500 uppercase"><%= product.brand %></p>
              <p class="text-sm font-medium text-black line-clamp-2 group-hover:underline"><%= product.name %></p>
              <p class="text-sm font-bold text-black"><%= number_to_currency(product.price, unit: "", precision: 0) %>원</p>
            </div>

          </a>
        <% end %>
      <% else %>
        <div class="col-span-2 md:col-span-4 py-12 text-center">
          <p class="text-sm text-gray-400">연관 상품이 없습니다.</p>
        </div>
      <% end %>
    </div>

  </div>

</div>

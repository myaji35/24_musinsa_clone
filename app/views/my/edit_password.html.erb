<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <%= render "my/nav", current: :info %>
  <h1 class="text-title font-semibold mb-6">비밀번호 변경</h1>
  <% if @user&.errors&.any? %>
    <ul role="alert" class="text-ui mb-6">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with scope: :password_change, url: my_password_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :current_password, "현재 비밀번호", class: "block text-ui font-medium mb-2" %>
      <div class="relative" data-controller="password-visibility">
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "field pr-16", data: { password_visibility_target: "input" } %>
        <button type="button" hidden class="tap btn-text text-caption absolute right-3 top-1/2 -translate-y-1/2" data-password-visibility-target="toggle" data-action="password-visibility#toggle" aria-pressed="false" aria-label="비밀번호 보기">보기</button>
      </div>
    </div>
    <div>
      <%= form.label :password, "새 비밀번호", class: "block text-ui font-medium mb-2" %>
      <div class="relative" data-controller="password-visibility">
        <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "field pr-16", data: { password_visibility_target: "input" } %>
        <button type="button" hidden class="tap btn-text text-caption absolute right-3 top-1/2 -translate-y-1/2" data-password-visibility-target="toggle" data-action="password-visibility#toggle" aria-pressed="false" aria-label="비밀번호 보기">보기</button>
      </div>
    </div>
    <div>
      <%= form.label :password_confirmation, "새 비밀번호 확인", class: "block text-ui font-medium mb-2" %>
      <div class="relative" data-controller="password-visibility">
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "field pr-16", data: { password_visibility_target: "input" } %>
        <button type="button" hidden class="tap btn-text text-caption absolute right-3 top-1/2 -translate-y-1/2" data-password-visibility-target="toggle" data-action="password-visibility#toggle" aria-pressed="false" aria-label="비밀번호 보기">보기</button>
      </div>
    </div>
    <%= form.submit "비밀번호 변경", class: "btn btn-primary w-full" %>
  <% end %>
  <%= link_to "취소", my_path, class: "btn btn-secondary w-full mt-3" %>
</div>

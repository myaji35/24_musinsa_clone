<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <h1 class="text-title font-semibold mb-6">로그인</h1>
  <%= form_with url: login_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "block text-ui font-medium mb-2" %>
      <%= form.email_field :email, value: params[:email], required: true, autocomplete: "username", class: "field" %>
    </div>
    <div>
      <%= form.label :password, "비밀번호", class: "block text-ui font-medium mb-2" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "field" %>
    </div>
    <%= form.submit "로그인", class: "btn btn-primary w-full" %>
  <% end %>
  <p class="text-ui mt-6">아직 회원이 아니신가요? <%= link_to "회원가입", join_path %></p>
</div>

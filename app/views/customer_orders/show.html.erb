<% member_order = logged_in? && current_user.member? && @orders.first.user_id == current_user.id %>
<div class="max-w-[720px] mx-auto px-gutter py-8 md:py-12 space-y-6">
  <%= render "my/nav", current: :orders if member_order %>
  <h1 class="text-title font-semibold">주문 내역</h1>
  <p class="break-all">주문서 번호: <%= @orders.first.checkout_number %></p>
  <p class="text-caption text-ink-2">주문일 <%= @orders.map(&:created_at).min.strftime("%Y.%m.%d %H:%M") %></p>
  <% @orders.each do |order| %>
    <div class="border-b border-hairline py-5 flex gap-4">
      <%= render "shared/product_thumb", product: order.product, link: product_path(order.product) %>
      <div class="min-w-0 flex-1 space-y-2">
        <span class="inline-block bg-ink text-inverse px-3 py-1 text-ui"><%= order.status_label %></span>
        <p class="text-ui font-medium"><%= order.product.name %></p>
        <p><%= order.variant.color %> / <%= order.variant.size %> · <%= order.quantity %>개</p>
        <p><%= price_won(order.total_price) %></p>
        <% active_claim = order.active_claim %>
        <% latest_claim = order.order_claims.where(status: %w[completed rejected]).order(created_at: :desc, id: :desc).first %>
        <% if active_claim %>
          <p class="text-ui"><%= active_claim.kind_label %> <%= active_claim.status_label %></p>
        <% elsif order.claimable_kinds.any? %>
          <%= link_to(order.claimable_kinds.include?("cancel") ? "취소 요청" : "반품·교환 요청", member_order ? new_my_order_claim_path(order) : new_customer_order_claim_path(order.checkout_number, order_id: order.id), class: "inline-flex items-center min-h-11 text-ui tap btn-text") %>
        <% end %>
        <% if latest_claim %>
          <p class="text-caption text-ink-2"><%= latest_claim.kind_label %> <%= latest_claim.status_label %></p>
        <% end %>
      </div>
    </div>
  <% end %>
  <p class="flex justify-between border-t border-line pt-4 text-ui font-medium">합계 <%= price_won(@orders.sum(&:total_price), variant: :lg) %></p>
  <% pending_orders = @orders.select { |order| order.status == "pending" } %>
  <% if pending_orders.any? %>
    <%= render "payment_instruction", instruction: PaymentInstruction.new, pending_orders: pending_orders, checkout_number: @orders.first.checkout_number, order_time: @orders.map(&:created_at).min, member_order: member_order %>
  <% end %>
  <h2 class="text-ui font-medium">배송지</h2>
  <% if @address %>
    <p><%= @address.recipient_name.first %>*</p>
    <p><%= @address.phone.gsub(/[^0-9]/, "").sub(/\A([0-9]{2,3})[0-9]+([0-9]{4})\z/, '\1-****-\2') %></p>
    <p class="break-words"><%= @address.postal_code %> <%= @address.address1 %></p>
  <% else %>
    <p>배송지 정보는 보관 기간이 지나 파기되었습니다</p>
  <% end %>
  <% if member_order %>
    <%= link_to "내 주문으로", my_orders_path, class: "btn btn-secondary w-full" %>
  <% else %>
    <%= link_to "쇼핑 계속하기", products_path, class: "btn btn-secondary w-full" %>
  <% end %>
</div>

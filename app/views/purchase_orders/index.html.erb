<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl md:text-3xl font-bold">발주서 관리</h1>
    <%= link_to "발주서 생성", new_purchase_order_path, class: "btn btn-primary" %>
  </div>

  <section class="mb-6" aria-labelledby="today-tasks-heading">
    <h2 id="today-tasks-heading" class="text-xl font-bold mb-3">오늘 할 일</h2>
    <div class="grid grid-cols-3 md:grid-cols-5 gap-2 md:gap-3">
      <% @today_tasks.each do |task| %>
        <%= link_to task[:path], class: "block rounded-lg p-3 md:p-4 #{task[:count].positive? ? "bg-white shadow border-l-4 #{task[:color]} text-gray-900" : 'bg-gray-50 shadow-none text-gray-400'}", aria: { label: "#{task[:name]} #{task[:count]}건" } do %>
          <strong class="block text-xl md:text-2xl"><%= task[:count] %></strong>
          <span class="block mt-1 text-xs md:text-sm leading-tight"><%= task[:name] %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <%= form_with url: purchase_orders_path, method: :get, class: "flex gap-2 mb-3" do %>
    <%= hidden_field_tag :status, @selected_status if @selected_status %>
    <%= search_field_tag :q, params[:q], placeholder: "발주번호 또는 거래처 이름", aria: { label: "발주번호 또는 거래처 이름" }, class: "field w-full md:w-80" %>
    <%= submit_tag "찾기", class: "btn" %>
  <% end %>
  <% if @query.present? %>
    <p class="mb-3">“<%= @query %>” 검색 결과 <%= @purchase_orders.size %>건 · <%= link_to "검색 지우기", purchase_orders_path(status: @selected_status), class: "text-blue-600" %></p>
  <% end %>

  <nav class="flex gap-2 mb-6 overflow-x-auto whitespace-nowrap md:flex-wrap" aria-label="발주 상태 필터">
    <%= link_to "전체", purchase_orders_path(q: @query.presence), class: "chip#{' font-bold' unless @selected_status}", aria: { current: ("page" unless @selected_status) } %>
    <% @status_filters.each do |status, label| %>
      <%= link_to label, purchase_orders_path(status: status, q: @query.presence), class: "chip#{' font-bold' if @selected_status == status}", aria: { current: ("page" if @selected_status == status) } %>
    <% end %>
  </nav>

  <% if @purchase_orders.any? %>
    <div class="bg-white rounded-lg shadow overflow-hidden hidden md:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">발주번호</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">거래처</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">상태</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">총액</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">납품 예정일</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">등록일</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">작업</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @purchase_orders.each do |po| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to po.order_number, purchase_order_path(po), class: "text-blue-600 hover:text-blue-800 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.supplier.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= purchase_order_status_badge_class(po.status) %>">
                  <%= purchase_order_status_label(po.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">₩<%= number_with_delimiter(po.total_amount.to_i) %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex items-center gap-2">
                <%= link_to "상세", purchase_order_path(po), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <% if po.status == "draft" %>
                  <%= link_to "수정", edit_purchase_order_path(po), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                  <%= button_to "취소", purchase_order_path(po), method: :delete, form: { data: { turbo_confirm: "정말 취소하시겠습니까?" } }, class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <ul class="md:hidden space-y-3">
      <% @purchase_orders.each do |po| %>
        <li class="border rounded-lg p-4 bg-white shadow-sm">
          <div class="flex justify-between items-center gap-2">
            <%= link_to po.order_number, purchase_order_path(po), class: "tap font-bold text-blue-600 hover:text-blue-800" %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= purchase_order_status_badge_class(po.status) %>">
              <%= purchase_order_status_label(po.status) %>
            </span>
          </div>
          <div class="mt-2"><%= po.supplier.name %></div>
          <div class="mt-2 flex justify-between items-center gap-2">
            <strong>₩<%= number_with_delimiter(po.total_amount.to_i) %></strong>
            <span>납품 <%= po.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></span>
          </div>
          <% if po.status == "draft" %>
            <div class="mt-3 flex items-center gap-3 text-sm font-medium">
              <%= link_to "수정", edit_purchase_order_path(po), class: "tap text-blue-600 hover:text-blue-900" %>
              <%= button_to "취소", purchase_order_path(po), method: :delete, form: { data: { turbo_confirm: "정말 취소하시겠습니까?" } }, class: "tap text-red-600 hover:text-red-900" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
      <%= @query.present? ? "검색 결과가 없습니다." : (@selected_status ? "해당 상태의 발주서가 없습니다." : "등록된 발주서가 없습니다. 새로운 발주서를 생성해주세요.") %>
    </div>
  <% end %>
</div>

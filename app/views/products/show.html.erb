<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">

  <!-- 상품 메인 섹션 -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 mb-20">

    <!-- 좌측: 이미지 갤러리 -->
    <div class="space-y-4">
      <!-- 메인 이미지 -->
      <div class="w-full aspect-[3/4] bg-gray-100 overflow-hidden">
        <% if @product.image_url.present? %>
          <img src="<%= @product.image_url %>" alt="<%= @product.name %>" class="w-full h-full object-cover">
        <% else %>
          <div class="w-full h-full flex items-center justify-center text-gray-300">
            <span class="text-sm font-medium">이미지 없음</span>
          </div>
        <% end %>
      </div>

      <!-- 썸네일 그리드 -->
      <div class="grid grid-cols-4 gap-2">
        <% 4.times do |i| %>
          <div class="aspect-[3/4] bg-gray-100 border-2 <%= i == 0 ? 'border-black' : 'border-transparent' %> cursor-pointer hover:border-black transition-colors overflow-hidden">
            <% if i == 0 && @product.image_url.present? %>
              <img src="<%= @product.image_url %>" alt="<%= @product.name %>" class="w-full h-full object-cover">
            <% else %>
              <div class="w-full h-full bg-gray-50"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 우측: 상품 정보 -->
    <div class="space-y-6" data-controller="variant-selector">

      <!-- 브랜드 & 상품명 -->
      <div class="space-y-2">
        <p class="text-sm font-medium text-gray-500 uppercase"><%= @product.brand %></p>
        <h1 class="text-2xl md:text-3xl font-bold text-black leading-tight"><%= @product.name %></h1>
      </div>

      <!-- 가격 -->
      <div class="space-y-1">
        <p class="text-3xl font-bold text-black"><%= number_to_currency(@product.price, unit: "", precision: 0) %>원</p>
      </div>

      <div class="h-px bg-gray-200"></div>

      <!-- Variant 선택: 색상 -->
      <div class="space-y-3">
        <p class="text-sm font-medium text-black">색상</p>
        <div class="flex flex-wrap gap-2">
          <% if @variants.present? %>
            <% @variants.map(&:color).uniq.each_with_index do |color, index| %>
              <button
                type="button"
                class="px-4 py-2 border-2 text-sm font-medium transition-colors <%= index == 0 ? 'border-black bg-black text-white' : 'border-gray-300 bg-white text-black hover:border-black' %>"
                data-action="click->variant-selector#selectColor"
                data-color="<%= color %>">
                <%= color %>
              </button>
            <% end %>
          <% else %>
            <button
              type="button"
              class="px-4 py-2 border-2 border-black bg-black text-white text-sm font-medium"
              disabled>
              기본 색상
            </button>
          <% end %>
        </div>
      </div>

      <!-- Variant 선택: 사이즈 -->
      <div class="space-y-3">
        <p class="text-sm font-medium text-black">사이즈</p>
        <div class="flex flex-wrap gap-2">
          <% if @variants.present? %>
            <% @variants.map(&:size).uniq.each_with_index do |size, index| %>
              <button
                type="button"
                class="px-4 py-2 border-2 text-sm font-medium transition-colors <%= index == 0 ? 'border-black bg-black text-white' : 'border-gray-300 bg-white text-black hover:border-black' %>"
                data-action="click->variant-selector#selectSize"
                data-size="<%= size %>">
                <%= size %>
              </button>
            <% end %>
          <% else %>
            <button
              type="button"
              class="px-4 py-2 border-2 border-black bg-black text-white text-sm font-medium"
              disabled>
              FREE
            </button>
          <% end %>
        </div>
      </div>

      <!-- 재고 표시 -->
      <div class="flex items-center gap-2">
        <p class="text-sm text-gray-600">재고:</p>
        <p class="text-sm font-bold text-black" data-variant-selector-target="stock">
          <% if @selected_variant.present? %>
            <%= @selected_variant.stock %>개
          <% else %>
            <%= @product.stock %>개
          <% end %>
        </p>
      </div>

      <div class="h-px bg-gray-200"></div>

      <!-- 수량 선택 -->
      <div class="space-y-3">
        <p class="text-sm font-medium text-black">수량</p>
        <div class="flex items-center border-2 border-gray-300 w-32">
          <button
            type="button"
            class="w-10 h-10 flex items-center justify-center text-lg font-medium hover:bg-gray-50 transition-colors"
            data-action="click->variant-selector#decreaseQuantity">
            -
          </button>
          <input
            type="number"
            value="1"
            min="1"
            class="flex-1 h-10 text-center border-x-2 border-gray-300 text-sm font-medium focus:outline-none"
            data-variant-selector-target="quantity"
            readonly>
          <button
            type="button"
            class="w-10 h-10 flex items-center justify-center text-lg font-medium hover:bg-gray-50 transition-colors"
            data-action="click->variant-selector#increaseQuantity">
            +
          </button>
        </div>
      </div>

      <!-- 총 가격 -->
      <div class="flex items-center justify-between py-4 border-t-2 border-black">
        <p class="text-lg font-bold text-black">총 상품금액</p>
        <p class="text-2xl font-bold text-black" data-variant-selector-target="totalPrice">
          <%= number_to_currency(@product.price, unit: "", precision: 0) %>원
        </p>
      </div>

      <!-- 액션 버튼 -->
      <div class="grid grid-cols-2 gap-3">
        <button
          type="button"
          class="py-4 bg-black text-white text-sm font-bold hover:bg-gray-800 transition-colors">
          바로구매
        </button>
        <button
          type="button"
          class="py-4 bg-black text-white text-sm font-bold hover:bg-gray-800 transition-colors">
          장바구니
        </button>
      </div>

      <!-- 상품 설명 -->
      <div class="pt-6 space-y-3">
        <p class="text-sm font-medium text-black">상품 설명</p>
        <p class="text-sm text-gray-600 leading-relaxed"><%= @product.description %></p>
      </div>

    </div>
  </div>

  <!-- 리뷰 섹션 -->
  <div class="border-t-2 border-gray-200 pt-12 mb-20">

    <!-- 리뷰 헤더 -->
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-black">
        리뷰
        <span class="text-gray-400">(<%= @reviews.count %>)</span>
      </h2>
      <div class="flex items-center gap-2">
        <div class="flex text-yellow-400">
          <% 5.times do %>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          <% end %>
        </div>
        <span class="text-lg font-bold text-black"><%= @average_rating.present? ? sprintf("%.1f", @average_rating) : "5.0" %></span>
      </div>
    </div>

    <!-- 리뷰 카드 -->
    <div class="space-y-6">
      <% if @reviews.any? %>
        <% @reviews.each do |review| %>
          <div class="border-b border-gray-100 pb-6 last:border-b-0">

            <!-- 리뷰 헤더 -->
            <div class="flex items-start justify-between mb-3">
              <div class="space-y-1">
                <p class="text-sm font-bold text-black"><%= review.user.name %></p>
                <div class="flex items-center gap-1 text-yellow-400">
                  <% review.rating.times do %>
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% end %>
                  <% (5 - review.rating).times do %>
                    <svg class="w-4 h-4 fill-current text-gray-200" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
              <p class="text-xs text-gray-400"><%= review.created_at.strftime("%Y.%m.%d") %></p>
            </div>

            <!-- 리뷰 내용 -->
            <p class="text-sm text-gray-700 leading-relaxed mb-3"><%= review.content %></p>

            <!-- 리뷰 추가 정보 -->
            <div class="flex flex-wrap gap-2 text-xs text-gray-500">
              <% if review.height.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">키 <%= review.height %>cm</span>
              <% end %>
              <% if review.weight.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">몸무게 <%= review.weight %>kg</span>
              <% end %>
              <% if review.size_purchased.present? %>
                <span class="px-2 py-1 bg-gray-50 border border-gray-200">구매 사이즈 <%= review.size_purchased %></span>
              <% end %>
            </div>

            <!-- 리뷰 사진 -->
            <% if review.photo_url.present? %>
              <div class="mt-3">
                <img src="<%= review.photo_url %>" alt="리뷰 사진" class="w-32 h-32 object-cover border border-gray-200">
              </div>
            <% end %>

          </div>
        <% end %>
      <% else %>
        <div class="py-12 text-center">
          <p class="text-sm text-gray-400">아직 작성된 리뷰가 없습니다.</p>
        </div>
      <% end %>
    </div>

  </div>

  <!-- 연관 상품 섹션 -->
  <div class="border-t-2 border-gray-200 pt-12">

    <h2 class="text-xl md:text-2xl font-bold text-black mb-8">연관 상품</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      <% if @related_products.present? %>
        <% @related_products.take(4).each do |product| %>
          <a href="<%= product_path(product) %>" class="group space-y-3">

            <!-- 상품 이미지 -->
            <div class="w-full aspect-[3/4] bg-gray-100 overflow-hidden">
              <% if product.image_url.present? %>
                <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <span class="text-xs">이미지 없음</span>
                </div>
              <% end %>
            </div>

            <!-- 상품 정보 -->
            <div class="space-y-1">
              <p class="text-xs text-gray-500 uppercase"><%= product.brand %></p>
              <p class="text-sm font-medium text-black line-clamp-2 group-hover:underline"><%= product.name %></p>
              <p class="text-sm font-bold text-black"><%= number_to_currency(product.price, unit: "", precision: 0) %>원</p>
            </div>

          </a>
        <% end %>
      <% else %>
        <div class="col-span-2 md:col-span-4 py-12 text-center">
          <p class="text-sm text-gray-400">연관 상품이 없습니다.</p>
        </div>
      <% end %>
    </div>

  </div>

</div>

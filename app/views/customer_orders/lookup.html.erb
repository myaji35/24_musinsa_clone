<div class="max-w-[720px] mx-auto px-gutter py-8 md:py-12 space-y-6">
  <h1 class="text-title font-semibold">주문조회</h1>
  <% if @error %><p role="alert"><%= @error %></p><% end %>
  <%= form_with url: orders_lookup_path, class: "space-y-4" do |f| %>
    <%= f.label :checkout_number, "주문서 번호", class: "block text-ui font-medium mb-2" %>
    <%= f.text_field :checkout_number, required: true, class: "field" %>
    <%= f.label :phone_suffix, "휴대폰 뒤 4자리", class: "block text-ui font-medium mb-2" %>
    <%= f.text_field :phone_suffix, required: true, maxlength: 4, pattern: "[0-9]{4}", inputmode: "numeric", class: "field" %>
    <%= f.submit "조회하기", class: "btn btn-primary w-full" %>
  <% end %>
</div>

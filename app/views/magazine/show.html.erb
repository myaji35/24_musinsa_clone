<% content_for :title, "#{@article['title']} | JIEUM 매거진" %>
<% admin = mall_admin? %>
<article class="pb-20" data-testid="magazine-article">
  <% unless @issue.published? %>
    <p class="max-w-3xl mx-auto mt-6 px-4 text-caption font-medium"><span class="inline-block px-3 py-1 bg-amber-100 text-amber-900">초안 · 관리자 미리보기</span></p>
  <% end %>
  <header class="relative bg-black">
    <%= catalog_image_tag catalog_shot_url(@article.dig("hero", "product"), @article.dig("hero", "shot")), sizes: "100vw", alt: "", class: "w-full aspect-[4/5] md:aspect-[16/8] object-cover opacity-90", style: "object-position: 50% 6%" %>
    <div class="absolute inset-x-0 bottom-0 px-6 md:px-0 pt-28 pb-10 bg-gradient-to-t from-black/75 to-transparent text-white">
      <div class="max-w-[720px] mx-auto md:px-gutter">
        <p class="font-display text-eyebrow tracking-eyebrow uppercase text-white/80"><%= @article["kicker"] %> · Issue <%= format("%02d", @issue.number) %></p>
        <h1 class="mt-2 text-title font-semibold text-balance"><%= @article["title"] %></h1>
        <p class="mt-4 text-body text-white/90 leading-relaxed"><%= @article["lede"] %></p>
      </div>
    </div>
    <span class="absolute top-3 left-4 text-caption text-white/85 [text-shadow:0_1px_3px_rgba(0,0,0,.8)]">AI 가상 인물</span>
  </header>

  <div class="max-w-[720px] mx-auto px-gutter mt-12 space-y-12">
    <% Array(@article["blocks"]).each do |block| %>
      <% case block["type"] %>
      <% when "text" %>
        <p class="text-body text-ink-2"><%= block["body"] %></p>
      <% when "image" %>
        <figure>
          <%= link_to_if (product = @issue.products([ block["product"] ], admin: admin).first), catalog_image_tag(catalog_shot_url(block["product"], block["shot"]), sizes: "(min-width: 768px) 720px, 100vw", alt: block["caption"].to_s, loading: "lazy", class: "w-full aspect-[2/3] object-cover bg-placeholder"), (product && product_path(product)) %>
          <figcaption class="mt-2 flex justify-between gap-4 text-caption text-ink-3">
            <span><%= block["caption"] %></span>
            <% if product %><span class="shrink-0 text-ink"><%= product.name %> · <%= price_won(product.price) %></span><% end %>
          </figcaption>
        </figure>
      <% when "tip" %>
        <aside class="p-6 bg-paper-2">
          <p class="font-display text-eyebrow tracking-eyebrow uppercase text-ink-3">Styling Tip</p>
          <h2 class="mt-1 text-title font-semibold text-ink"><%= block["title"] %></h2>
          <ul class="mt-3 space-y-2 text-body text-ink-2">
            <% Array(block["items"]).each do |item| %><li class="flex gap-2"><span aria-hidden="true">—</span><span><%= item %></span></li><% end %>
          </ul>
        </aside>
      <% when "products" %>
        <% products = @issue.products(block["ids"], admin: admin) %>
        <% if products.any? %>
          <section aria-label="기사에 나온 상품" class="-mx-4 md:-mx-24">
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-2 md:gap-x-3 gap-y-7 md:gap-y-10 px-4">
              <% products.each do |item| %><%= render "products/card", product: item %><% end %>
            </div>
          </section>
        <% end %>
      <% when "character" %>
        <% character = Character.find_by(handle: block["handle"]) %>
        <aside class="flex gap-4 items-start border-l-2 border-line pl-5">
          <div>
            <p class="text-body font-medium text-ink">캐릭터 노트 · <%= character&.name || block["handle"] %><span class="ml-2 text-caption font-normal text-ink-3">가상 인물</span></p>
            <p class="mt-1 text-body leading-relaxed text-ink-2"><%= block["body"] %></p>
          </div>
        </aside>
      <% end %>
    <% end %>

    <footer class="pt-8 border-t border-hairline space-y-4">
      <% if @article["virtual_note"] %>
        <p class="text-caption text-ink-3">기사 속 모델은 AI로 만든 가상 인물이며, 의류는 실제 판매 상품입니다.</p>
      <% end %>
      <%= link_to "← 매거진 목록", magazine_path, class: "btn-text text-caption text-ink-2" %>
    </footer>
  </div>
</article>

<% content_for :title, "트렌드 - JIEUM" %>
<div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">시즌·트렌드 상품 선정</h1>
    <span class="rounded bg-gray-100 px-3 py-2 text-sm font-medium"><%= @api_configured ? "API 키 있음" : "API 키 없음 — CSV 업로드를 쓰세요" %></span>
  </div>
  <section class="bg-white border rounded-lg p-6 space-y-4">
    <h2 class="text-lg font-bold">주간 실측 CSV 업로드</h2>
    <p class="text-sm text-gray-600">네이버 데이터랩 쇼핑인사이트에서 의류 카테고리와 조회 기간을 선택하세요.<br>연령대 필터를 확인하고 조회 결과를 CSV로 내려받으세요.<br>같은 연령대를 선택해 업로드하면 월요일 시작 주간 평균으로 저장됩니다.</p>
    <%= form_with url: trends_path, multipart: true, class: "flex flex-wrap items-end gap-4" do |form| %>
      <div><%= form.label :file, "CSV 파일", class: "block text-sm font-medium mb-2" %><%= form.file_field :file, accept: ".csv", required: true, class: "block border rounded p-2" %></div>
      <div><%= form.label :age_band, "연령대", class: "block text-sm font-medium mb-2" %><%= form.select :age_band, [["전체", ""], ["20대", 20], ["30대", 30], ["40대", 40], ["50대", 50]], {}, class: "border rounded p-2" %></div>
      <div><%= form.label :note, "메모", class: "block text-sm font-medium mb-2" %><%= form.text_field :note, class: "border rounded p-2" %></div>
      <%= form.submit "CSV 업로드", class: "bg-black text-white rounded px-4 py-2 cursor-pointer" %>
    <% end %>
  </section>
  <% if @snapshots.empty? %>
    <p class="bg-white border rounded-lg p-6">아직 트렌드 데이터가 없습니다. 데이터랩에서 CSV를 내려받아 위 폼으로 업로드하세요.</p>
  <% end %>
  <section class="bg-white border rounded-lg p-6 overflow-x-auto">
    <h2 class="text-lg font-bold mb-2">캐릭터별 추천</h2>
    <p class="text-sm text-gray-600 mb-4">최근 4주 평균과 직전 4주 평균의 상승률 순입니다. 연령대 실측을 우선 사용하며, 없으면 전체 실측을 사용합니다. 상대지수는 조회 조건에 따라 달라지므로 동일한 조건으로 수집하세요.</p>
    <table class="w-full text-sm text-left"><thead><tr class="border-b"><th class="p-3">캐릭터</th><th class="p-3">연령대</th><th class="p-3">담당 의류</th><th class="p-3">상위 시리즈 · 상승률 · 후보 상품</th></tr></thead><tbody>
      <% @recommendations.each do |character, rows| %>
        <tr class="border-b"><td class="p-3"><%= character.name %></td><td class="p-3"><%= character.age_band ? "#{character.age_band}대" : "미지정" %></td><td class="p-3"><%= character.wardrobe %></td><td class="p-3 space-y-3">
          <% rows.each do |row| %>
            <div><p class="font-medium"><%= row[:series_name] %> · <%= row[:status] %> · <%= row[:growth] ? "#{number_with_precision(row[:growth], precision: 1)}%" : "상승률 계산 불가" %> · 최근 지수 <%= number_with_precision(row[:latest], precision: 2) %></p>
              <% if row[:products].empty? %><p class="text-gray-500">후보 상품 없음</p><% end %>
              <% row[:products].each do |product| %><%= link_to product.name, product_path(product), class: "block text-green-700 underline" %><% end %>
            </div>
          <% end %>
        </td></tr>
      <% end %>
    </tbody></table>
    <% if @characters_without_data.any? %>
      <p class="mt-4 text-sm text-gray-600">데이터 없음: <%= @characters_without_data.map(&:name).join(", ") %> — 담당 의류 CSV를 올리면 추천이 표시됩니다</p>
    <% end %>
  </section>
  <section class="bg-white border rounded-lg p-6">
    <h2 class="text-lg font-bold mb-4">최근 스냅샷 요약</h2>
    <table class="w-full text-sm text-left"><thead><tr class="border-b"><th class="p-3">시리즈</th><th class="p-3">최신 주</th><th class="p-3">상대지수</th><th class="p-3">연령대 · 출처</th></tr></thead><tbody>
      <% @snapshots.each do |name, snapshot| %><tr class="border-b"><td class="p-3"><%= name %></td><td class="p-3"><%= snapshot.period_start %></td><td class="p-3"><%= number_with_precision(snapshot.ratio, precision: 2) %></td><td class="p-3"><%= snapshot.age_band ? "#{snapshot.age_band}대" : "전체" %> · <%= snapshot.source == "datalab_csv" ? "CSV" : "API" %></td></tr><% end %>
    </tbody></table>
  </section>
</div>

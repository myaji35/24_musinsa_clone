<div class="max-w-5xl mx-auto p-6 space-y-6">
  <h1 class="text-2xl font-bold">주문 클레임</h1>
  <nav aria-label="클레임 상태 필터" class="flex flex-wrap gap-2">
    <% { "ongoing" => "진행 중", **OrderClaim::STATUSES, "all" => "전체" }.each do |status, label| %>
      <%= link_to label, admin_order_claims_path(status: status), class: "min-h-11 inline-flex items-center rounded border px-3 #{@status == status ? 'font-bold bg-gray-100' : ''}", aria: { current: (@status == status ? "page" : nil) } %>
    <% end %>
  </nav>
  <p>총 <%= @total_count %>건</p>
  <% if @claims.empty? %>
    <p class="rounded border p-4">클레임이 없습니다.</p>
  <% end %>
  <div class="hidden lg:block overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead><tr><th>주문번호</th><th>상품·옵션</th><th>종류</th><th>상태</th><th>접수일</th><th>처리</th></tr></thead>
      <tbody>
        <% @claims.each do |claim| %>
          <tr class="border-b">
            <td><%= claim.order.order_number %></td>
            <td><%= claim.order.product.name %> / <%= [claim.order.variant.color, claim.order.variant.size].join(" / ") %></td>
            <td><%= claim.kind_label %></td><td><%= claim.status_label %></td>
            <td><%= seoul_datetime(claim.created_at) %></td>
            <td><%= link_to "상세", admin_order_claim_path(claim), class: "min-h-11 inline-flex items-center px-3 underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <ul class="lg:hidden space-y-4">
    <% @claims.each do |claim| %>
      <li class="rounded border p-4 space-y-3">
        <div class="flex items-start justify-between gap-3">
          <p class="min-w-0 break-words font-semibold"><%= claim.order.order_number %></p>
          <p class="shrink-0"><%= claim.kind_label %> · <%= claim.status_label %></p>
        </div>
        <p class="break-words"><%= claim.order.product.name %> / <%= [claim.order.variant.color, claim.order.variant.size].join(" / ") %></p>
        <p class="text-sm">접수일 <%= seoul_datetime(claim.created_at) %></p>
        <%= link_to "상세", admin_order_claim_path(claim), class: "min-h-11 inline-flex items-center px-3 underline" %>
      </li>
    <% end %>
  </ul>
  <nav aria-label="페이지" class="flex flex-wrap items-center gap-3">
    <% if @page > 1 %>
      <%= link_to "이전", admin_order_claims_path(status: @status, page: @page - 1), class: "min-h-11 inline-flex items-center px-3 underline" %>
    <% end %>
    <p><%= @page %> / <%= [@total_pages, 1].max %></p>
    <% if @page < @total_pages %>
      <%= link_to "다음", admin_order_claims_path(status: @status, page: @page + 1), class: "min-h-11 inline-flex items-center px-3 underline" %>
    <% end %>
  </nav>
</div>

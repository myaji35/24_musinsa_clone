<% spec_tab = local_assigns.fetch(:spec_tab, false) %>
<nav class="flex gap-6 border-b border-gray-200 mb-6" aria-label="상품 편집 탭">
  <% [["상품 정보", edit_product_path(product), !spec_tab && params[:tab] != "inventory"], ["재고이력", edit_product_path(product, tab: "inventory"), !spec_tab && params[:tab] == "inventory"], ["상세스펙", edit_product_spec_path(product), spec_tab]].each do |label, path, active| %>
    <%= link_to label, path, aria: { current: active ? "page" : nil }, class: "px-1 py-3 text-sm font-medium #{active ? 'border-b-2 border-black text-gray-900' : 'text-gray-500'}" %>
  <% end %>
</nav>

<%# 룩북 사진(같은 상품의 햇살·밤·동작 3컷) → 그 묶음 상품 4개 %>
<% banner = story[:banner] %>
<% shots = banner.gallery_image_urls.reject { |url| url.end_with?("/real.jpg", "/front.jpg") }.first(3) %>
<section aria-labelledby="story-<%= story[:key] %>" class="mb-20" data-testid="home-story">
  <% if shots.any? %>
    <%= link_to(story[:category] ? root_path(category: story[:category], anchor: "ranking") : product_path(banner), class: "relative block -mx-4 md:-mx-8 mb-8 overflow-hidden bg-gray-100") do %>
      <div class="grid grid-cols-1 md:grid-cols-3">
        <% shots.each_with_index do |url, index| %>
          <%= catalog_image_tag url, sizes: "(min-width: 768px) 33vw, 100vw", alt: "#{banner.name} 룩북", loading: "lazy",
                class: "w-full aspect-[4/5] md:aspect-[2/3] object-cover #{'hidden md:block' if index.positive?}" %>
        <% end %>
      </div>
      <div class="absolute inset-x-0 bottom-0 px-6 md:px-10 pt-24 pb-8 bg-gradient-to-t from-black/60 to-transparent text-white">
        <p class="font-oswald text-sm tracking-[.2em] uppercase text-white/85"><%= story[:en] %></p>
        <h2 id="story-<%= story[:key] %>" class="text-3xl md:text-4xl font-bold tracking-[-0.02em]"><%= story[:title] %></h2>
        <p class="mt-2 text-[15px] text-white/90"><%= story[:copy] %></p>
      </div>
      <% if banner.worn_character %>
        <span class="absolute top-3 left-4 md:left-8 text-[11px] text-white/90 [text-shadow:0_1px_3px_rgba(0,0,0,.8)]"><%= banner.worn_character.name %> · AI 가상 인물</span>
      <% end %>
    <% end %>
  <% else %>
    <h2 id="story-<%= story[:key] %>" class="text-2xl font-bold mb-6"><%= story[:title] %></h2>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-10">
    <% story[:products].each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
  <% if story[:category] %>
    <div class="text-center mt-8">
      <%= link_to "#{story[:title]} 전체 보기", root_path(category: story[:category], anchor: "ranking"), class: "inline-block px-6 py-2 border border-gray-300 text-sm font-medium text-gray-800 hover:border-black" %>
    </div>
  <% end %>
</section>

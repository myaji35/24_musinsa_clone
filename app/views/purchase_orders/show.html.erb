<div class="container mx-auto px-4 py-8">
  <div class="flex flex-wrap gap-3 justify-between items-center mb-6">
    <h1 class="text-2xl md:text-3xl font-bold">발주서 상세 - <span class="block md:inline"><%= @purchase_order.order_number %></span></h1>
    <div class="flex items-center gap-2">
      <% if @purchase_order.status == "draft" %>
        <%= link_to "수정", edit_purchase_order_path(@purchase_order), class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg whitespace-nowrap mr-2" %>
        <%= button_to "제출", submit_purchase_order_path(@purchase_order), method: :post, form: { data: { turbo_confirm: "발주서를 거래처에 제출하시겠습니까?" } }, class: "bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg whitespace-nowrap mr-2" %>
      <% end %>
      <%= link_to "목록", purchase_orders_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg whitespace-nowrap" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-4">거래처 정보</h2>
      <div class="space-y-2">
        <div>
          <p class="text-sm text-gray-600">거래처명</p>
          <p class="font-medium">
            <%= link_to @purchase_order.supplier.name, supplier_path(@purchase_order.supplier), class: "text-blue-600 hover:text-blue-800" %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-600">담당자</p>
          <p class="font-medium"><%= @purchase_order.supplier.contact_person || "-" %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">연락처</p>
          <p class="font-medium"><%= @purchase_order.supplier.phone %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-4">발주 정보</h2>
      <div class="space-y-2">
        <div>
          <p class="text-sm text-gray-600">상태</p>
          <% status_class = case @purchase_order.status
            when "draft" then "bg-gray-100 text-gray-800"
            when "submitted" then "bg-yellow-100 text-yellow-800"
            when "confirmed" then "bg-blue-100 text-blue-800"
            when "partially_received" then "bg-blue-100 text-blue-800"
            when "received" then "bg-green-100 text-green-800"
            when "cancelled" then "bg-red-100 text-red-800"
            end %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
            <%= purchase_order_status_label(@purchase_order.status) %>
          </span>
        </div>
        <div>
          <p class="text-sm text-gray-600">총액</p>
          <p class="font-medium text-xl text-blue-600">₩<%= number_with_delimiter(@purchase_order.total_amount.to_i) %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">납품 예정일</p>
          <p class="font-medium"><%= @purchase_order.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-4">처리 이력</h2>
      <div class="space-y-2">
        <div>
          <p class="text-sm text-gray-600">등록일</p>
          <p class="font-medium"><%= @purchase_order.created_at.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
        <% if @purchase_order.confirmed_at %>
          <div>
            <p class="text-sm text-gray-600">확정일</p>
            <p class="font-medium"><%= @purchase_order.confirmed_at.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
        <% end %>
        <% if @purchase_order.received_at %>
          <div>
            <p class="text-sm text-gray-600">입고일</p>
            <p class="font-medium"><%= @purchase_order.received_at.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @purchase_order.status.in?(%w[confirmed partially_received]) %>
    <section class="bg-white rounded-lg shadow p-6 mb-6 border-2 border-blue-500">
      <h2 class="text-xl font-bold mb-4">입고 처리 <span class="text-sm font-normal text-gray-600">남은 수량 <%= @purchase_order_items.sum { |item| item.quantity - item.received_quantity } %>개</span></h2>
      <%= form_with url: receive_purchase_order_path(@purchase_order), method: :post, data: { turbo_confirm: "입고한 수량만큼 재고가 늘어납니다. 계속할까요?" } do %>
        <div role="table" aria-label="입고 처리 품목">
          <div role="row" class="hidden md:grid md:grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-2 font-semibold text-sm py-2 border-b">
            <div role="columnheader">상품·옵션</div>
            <div role="columnheader">발주 수량</div>
            <div role="columnheader">받은 수량(누적)</div>
            <div role="columnheader">남은 수량</div>
            <div role="columnheader">이번에 받은 수량</div>
          </div>
          <% @purchase_order_items.each do |item| %>
            <% remaining = item.quantity - item.received_quantity %>
            <div role="row" class="grid grid-cols-3 md:grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-2 py-3 border-b items-center">
              <div role="cell" class="col-span-3 md:col-span-1 font-medium"><%= item.product_name %> · <%= item.variant_name %></div>
              <div role="cell"><span class="md:hidden text-sm text-gray-500">발주 </span><%= item.quantity %></div>
              <div role="cell"><span class="md:hidden text-sm text-gray-500">받음 </span><%= item.received_quantity %></div>
              <div role="cell"><span class="md:hidden text-sm text-gray-500">남음 </span><%= remaining %></div>
              <div role="cell" class="col-span-3 md:col-span-1">
                <label class="flex items-center gap-2"><span class="md:hidden">이번에 받은 수량</span><%= number_field_tag "received_quantities[#{item.id}]", remaining, min: 0, max: remaining, inputmode: "numeric", class: "border rounded p-2 w-28", aria: { label: "#{item.product_name} #{item.variant_name} 이번에 받은 수량" } %></label>
              </div>
            </div>
          <% end %>
        </div>
        <%= submit_tag "입고 기록", class: "bg-blue-600 text-white px-4 py-3 rounded mt-4 w-full md:w-auto" %>
      <% end %>
    </section>
  <% end %>

  <% if @purchase_order.notes.present? %>
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-bold mb-2">메모</h2>
      <p class="text-gray-700"><%= @purchase_order.notes %></p>
    </div>
  <% end %>

  <% if @purchase_order.status == "submitted" %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            <strong>거래처 확인 대기 중</strong><br>
            거래처 확인 URL: <code class="bg-yellow-100 px-2 py-1 rounded"><%= @purchase_order.confirmation_url %></code>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold mb-4">발주 품목</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">상품명</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">옵션</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">수량</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">입고</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500">사입가</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">소계</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @purchase_order_items.each do |item| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap"><%= item.product_name %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= item.variant_name %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= item.quantity %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= item.received_quantity %> / <%= item.quantity %></td>
              <td class="px-6 py-4 whitespace-nowrap">₩<%= number_with_delimiter(item.unit_price.to_i) %></td>
              <td class="px-6 py-4 whitespace-nowrap font-medium">₩<%= number_with_delimiter(item.subtotal.to_i) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="bg-gray-50">
          <tr>
            <td colspan="5" class="px-6 py-4 text-right font-bold">총액</td>
            <td class="px-6 py-4 font-bold text-lg text-blue-600">₩<%= number_with_delimiter(@purchase_order.total_amount.to_i) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <% if @receipt_logs.any? %>
    <section class="bg-white rounded-lg shadow p-6 mt-6">
      <h2 class="text-xl font-bold mb-4">입고 이력</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50"><tr>
            <th class="px-6 py-3 text-left">일시</th><th class="px-6 py-3 text-left">상품</th>
            <th class="px-6 py-3 text-left">옵션</th><th class="px-6 py-3 text-left">수량</th>
          </tr></thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @receipt_logs.each do |log| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= log.variant.product.name %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= log.variant.color %> / <%= log.variant.size %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= log.quantity %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
<%= render "wechat/purchase_order_messages" %>

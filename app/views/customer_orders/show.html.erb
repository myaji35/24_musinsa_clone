<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
  <h1 class="text-2xl font-bold">주문 내역</h1>
  <p class="break-all">주문서 번호: <%= @orders.first.checkout_number %></p>
  <% @orders.each do |order| %>
    <div class="border-b border-gray-300 py-4 space-y-2">
      <span class="inline-block bg-black text-white px-3 py-1 text-sm"><%= { "pending" => "결제 대기", "paid" => "결제 완료", "shipped" => "배송 중", "delivered" => "배송 완료", "cancelled" => "취소" }[order.status] %></span>
      <p class="font-bold"><%= order.product.name %></p>
      <p><%= order.variant.color %> / <%= order.variant.size %> · <%= order.quantity %>개</p>
      <p><%= number_to_currency(order.total_price, unit: "", precision: 0) %>원</p>
    </div>
  <% end %>
  <p class="text-xl font-bold">합계 <%= number_to_currency(@orders.sum(&:total_price), unit: "", precision: 0) %>원</p>
  <% pending_orders = @orders.select { |order| order.status == "pending" } %>
  <% if pending_orders.any? %>
    <%= render "payment_instruction", instruction: PaymentInstruction.new, pending_orders: pending_orders, checkout_number: @orders.first.checkout_number, order_time: @orders.map(&:created_at).min %>
  <% end %>
  <h2 class="font-bold">배송지</h2>
  <% if @address %>
    <p><%= @address.recipient_name.first %>*</p>
    <p><%= @address.phone.gsub(/[^0-9]/, "").sub(/\A([0-9]{2,3})[0-9]+([0-9]{4})\z/, '\1-****-\2') %></p>
    <p class="break-words"><%= @address.postal_code %> <%= @address.address1 %></p>
  <% else %>
    <p>배송지 정보는 보관 기간이 지나 파기되었습니다</p>
  <% end %>
</div>

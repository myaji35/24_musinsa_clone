<%# 29cm 스타일 큐레이션 섹션 %>
<div class="mb-16">
  <%# 섹션 헤더 %>
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-black mb-2">
      <%= mood_to_title(mood) %>
    </h2>
    <p class="text-sm text-gray-500">
      <%= mood_to_description(mood) %>
    </p>
  </div>

  <%# 상품 그리드 (29cm 스타일: 모바일 2열, 데스크톱 4열) %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
    <% products.limit(4).each do |product| %>
      <%= render 'products/card', product: product %>
    <% end %>
  </div>

  <%# 더보기 링크 (선택사항) %>
  <div class="text-center mt-8">
    <a href="#" class="inline-block px-6 py-2 border border-gray-300 text-sm font-medium text-gray-700 hover:border-black hover:text-black transition-colors">
      더 많은 상품 보기
    </a>
  </div>
</div>

<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <nav aria-label="내 계정" class="flex gap-4 text-ui mb-6">
    <%= link_to "내 정보", my_path %>
    <%= link_to "내 주문", my_orders_path %>
  </nav>
  <h1 class="text-title font-semibold mb-6">내 정보</h1>
  <dl class="space-y-4 text-ui mb-6">
    <div><dt class="font-medium">이름</dt><dd><%= current_user.name %></dd></div>
    <div><dt class="font-medium">이메일</dt><dd><%= current_user.email %></dd></div>
    <div><dt class="font-medium">역할</dt><dd><%= current_user.role_label %></dd></div>
    <div><dt class="font-medium">가입일</dt><dd><%= current_user.created_at.strftime("%Y-%m-%d") %></dd></div>
  </dl>
  <%= button_to "로그아웃", logout_path, method: :delete, class: "btn btn-primary w-full" %>
</div>

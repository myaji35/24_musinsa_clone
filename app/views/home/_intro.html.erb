<% content_for :head do %>
<% end %>

<div class="intro" data-controller="scroll-scene">
  <a href="#shop" class="intro-skip" data-scroll-scene-target="skip">상품 바로 보기 <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
  <section class="intro-section intro-runway" data-scroll-scene-target="section" style="--p: 0">
    <div class="intro-stage intro-runway-stage">
      <div class="intro-runway-perspective" aria-hidden="true">
        <span class="intro-wordmark intro-wordmark-back">JIEUM</span>
        <span class="intro-wordmark intro-wordmark-front">JIEUM</span>
      </div>
      <div class="intro-video-perspective">
        <div class="intro-video-frame">
          <video data-scroll-scene-target="hero" src="/intro/yuna-runway.mp4" poster="/intro/yuna-runway-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="유나의 런웨이 영상"></video>
          <span class="intro-ai-badge">AI 가상인물</span>
        </div>
      </div>
      <div class="intro-runway-copy">
        <h1>2027 겨울 신상품</h1>
        <p>강유나 · 32 · Seoul</p>
      </div>
      <div class="intro-scroll-cue" aria-hidden="true">
        <span>스크롤</span>
        <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2"><path d="M12 3v17m-6-6 6 6 6-6" /></svg>
      </div>
    </div>
  </section>

  <%# 캐릭터 링은 스크롤에 묶지 않고 스스로 돈다(드래그·버튼으로 넘김) — 스크롤 한 번에 지나갈 수 있게 %>
  <section class="intro-section intro-characters" data-controller="intro-ring">
    <div class="intro-stage intro-characters-stage">
      <div class="intro-scene-heading">
        <span class="intro-eyebrow">THE CAST</span>
        <h2>20명의 캐릭터, 20개의 옷장</h2>
      </div>
      <% cache @intro_cache_key do %>
        <% intro_avatars = Avatar.all.index_by(&:handle) %>
        <div class="intro-ring-viewport" data-intro-ring-target="viewport"
             data-action="pointerdown->intro-ring#grab pointermove->intro-ring#drag pointerup->intro-ring#release pointercancel->intro-ring#release pointerenter->intro-ring#pause pointerleave->intro-ring#resume focusin->intro-ring#pause focusout->intro-ring#resume">
          <div class="intro-ring" data-intro-ring-target="ring">
            <% Character.for_intro.each_with_index do |character, index| %>
              <% avatar = intro_avatars[character.handle] %>
              <article class="intro-card intro-card-<%= character.age_band %>" style="--intro-index: <%= index %>" aria-labelledby="intro-character-<%= index %>">
                <span class="intro-card-band"><%= character.age_band %>s</span>
                <% if avatar %>
                  <%= image_tag avatar.card_image, class: "intro-card-photo", alt: "#{character.name} (AI 가상 인물)", loading: "lazy" %>
                  <span class="intro-card-virtual">가상 인물</span>
                <% else %>
                  <span class="intro-card-initial" aria-hidden="true"><%= character.handle.first %></span>
                <% end %>
                <div class="intro-card-details">
                  <span class="intro-card-romanized"><%= character.handle %></span>
                  <h3 id="intro-character-<%= index %>"><%= character.name %></h3>
                  <p><%= character.age %> · <%= character.birthplace %></p>
                  <p><%= character.style_axis %></p>
                  <% unless avatar %><span class="intro-card-soon">곧 공개</span><% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="intro-ring-controls">
        <button type="button" data-action="intro-ring#previous" aria-label="이전 캐릭터">‹</button>
        <button type="button" data-action="intro-ring#next" aria-label="다음 캐릭터">›</button>
      </div>
    </div>
  </section>

  <section id="runway-reel" class="intro-reel" aria-labelledby="runway-reel-heading" data-controller="runway-reel">
    <header class="intro-reel-heading">
      <span class="intro-eyebrow">THE RUNWAY</span>
      <h2 id="runway-reel-heading">10명이 걸어본 런웨이</h2>
    </header>
    <div class="intro-reel-strip">
      <% @runway_characters.each do |character| %>
        <article class="intro-reel-card">
          <div class="intro-reel-media">
            <video preload="none" muted playsinline loop poster="/intro/runway/<%= character.handle %>-poster.jpg" data-src="/intro/runway/<%= character.handle %>.mp4" data-runway-reel-target="video" data-action="play->runway-reel#sync pause->runway-reel#sync" aria-label="<%= character.name %> 런웨이 영상"></video>
            <span class="intro-ai-badge">AI 가상인물</span>
            <div class="intro-reel-details">
              <h3><%= character.name %></h3>
              <p><%= character.age %>세 · <%= character.birthplace %></p>
              <button type="button" aria-label="<%= character.name %> 런웨이 영상 재생" aria-pressed="false" data-name="<%= character.name %>" data-action="runway-reel#toggle">재생</button>
            </div>
          </div>
          <%= link_to "옷장 보기", character_path(character.handle), class: "intro-reel-wardrobe" %>
        </article>
      <% end %>
    </div>
  </section>

  <section class="intro-section intro-tagline" data-scroll-scene-target="section" style="--p: 0">
    <div class="intro-stage intro-tagline-stage">
      <div class="intro-tagline-content">
        <h2><span style="--intro-order: 0">주소는</span> <span style="--intro-order: 1">지우고,</span> <span style="--intro-order: 2">취향은</span> <span style="--intro-order: 3">잇다.</span></h2>
        <p>20~50대, 나와 닮은 캐릭터가 먼저 입어봅니다.</p>
        <a href="#runway-reel" class="intro-cta" inert>캐릭터 옷장 보기 <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
      </div>
    </div>
  </section>
</div>

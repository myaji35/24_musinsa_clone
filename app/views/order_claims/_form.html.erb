<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <%= render "my/nav", current: :orders if local_assigns[:member_nav] %>
  <% kinds = order.claimable_kinds %>
  <% title = kinds == ["cancel"] ? "취소 요청" : (kinds.include?("cancel") ? "취소·반품·교환 요청" : "반품·교환 요청") %>
  <h1 class="text-title font-semibold mb-6"><%= title %></h1>
  <div class="flex gap-4 text-ui mb-6">
    <%= render "shared/product_thumb", product: order.product %>
    <div>
      <p class="font-medium"><%= order.product.name %></p>
      <p><%= order.variant.color %> / <%= order.variant.size %> · 수량 <%= order.quantity %></p>
      <p><%= price_won(order.total_price) %></p>
    </div>
  </div>
  <% if claim.errors.any? %>
    <ul role="alert" class="text-ui mb-6">
      <% claim.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: claim, url: submit_url, method: :post, class: "space-y-4" do |form| %>
    <fieldset>
      <legend class="text-ui font-medium mb-2">요청 종류</legend>
      <% kinds.each do |kind| %>
        <label class="flex items-center gap-3 py-2 min-h-11 cursor-pointer text-ui">
          <%= form.radio_button :kind, kind, required: true, checked: (claim.kind.present? ? claim.kind == kind : kinds.one?) %>
          <%= OrderClaim::KINDS.fetch(kind) %>
        </label>
      <% end %>
    </fieldset>
    <div>
      <%= form.label :reason_code, "사유", class: "block text-ui font-medium mb-2" %>
      <%= form.select :reason_code, OrderClaim::REASONS.map { |code, label| [label, code] }, { prompt: "사유를 선택해 주세요" }, required: true, class: "field" %>
    </div>
    <div>
      <%= form.label :detail, "상세 내용 (선택)", class: "block text-ui font-medium mb-2" %>
      <%= form.text_area :detail, maxlength: 500, rows: 5, class: "field", aria: { describedby: "claim-detail-hint" } %>
      <p id="claim-detail-hint" class="text-caption text-ink-2 mt-2">500자 이내로 입력해 주세요.</p>
    </div>
    <div class="text-caption text-ink-2 space-y-2">
      <% if kinds.include?("cancel") %>
        <% if order.status == "pending" %>
          <p>결제 대기 주문의 취소는 바로 처리됩니다.</p>
        <% else %>
          <p>결제 완료 주문은 확인 후 환불해 드립니다(계좌이체 환불).</p>
        <% end %>
      <% end %>
      <% if kinds.any? { |kind| %w[return exchange].include?(kind) } %>
        <p>반품·교환은 배송 완료 후 7일 이내에 요청할 수 있으며, 단순 변심 반품 배송비는 고객 부담입니다.</p>
      <% end %>
    </div>
    <%= form.submit "요청하기", class: "btn btn-primary w-full" %>
  <% end %>
  <%= link_to "돌아가기", local_assigns[:back_url], class: "btn btn-secondary w-full mt-3" if local_assigns[:back_url] %>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex justify-between items-end mb-8 border-b border-black pb-4">
    <div>
      <h1 class="text-3xl font-black font-oswald uppercase tracking-tight">Street Snap</h1>
      <p class="text-sm text-gray-500 mt-1 font-medium">실시간 거리 패션과 최신 트렌드를 확인하세요.</p>
    </div>
  </div>

  <div class="columns-2 md:columns-3 lg:columns-4 gap-6 space-y-6">
    <% @snaps.each do |snap| %>
      <%= link_to snap_path(snap), class: "block break-inside-avoid mb-6 group" do %>
        <div class="w-full aspect-[3/4] bg-gray-200 flex items-center justify-center mb-3">
          <span class="text-sm text-gray-500">이미지 없음</span>
        </div>
        <div class="px-1">
          <div class="flex items-center gap-2 mb-2">
            <img src="https://ui-avatars.com/api/?name=<%= ERB::Util.url_encode(snap.user.name.to_s) %>&amp;background=random" alt="<%= snap.user.name %> 아바타" class="w-6 h-6 rounded-full bg-gray-300 object-cover">
            <span class="text-xs font-bold"><%= snap.user.name %></span>
          </div>
          <p class="text-sm font-medium text-gray-800 line-clamp-2 leading-snug mb-2 font-sans group-hover:underline"><%= snap.content.presence || "내용 없음" %></p>
          <time datetime="<%= snap.created_at.iso8601 %>" class="text-[10px] text-gray-400"><%= time_ago_in_words(snap.created_at) %> 전</time>
        </div>
      <% end %>
    <% end %>
  </div>
  <% if @snaps.empty? %>
    <p class="py-12 text-center text-sm text-gray-500">등록된 스냅이 없습니다.</p>
  <% end %>
</div>

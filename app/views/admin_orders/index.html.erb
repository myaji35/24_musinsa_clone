<div class="max-w-5xl mx-auto p-6">
  <h1 class="text-2xl font-bold">주문 관리</h1>
  <section class="my-6">
    <h2 class="text-lg font-bold mb-3">유입원별 집계</h2>
    <div class="grid gap-4 md:grid-cols-3">
      <% { platform: "플랫폼별", character: "캐릭터별", video: "영상별" }.each do |by, title| %>
        <div class="rounded border p-3">
          <h3 class="font-semibold mb-2"><%= title %></h3>
          <table class="w-full text-left text-sm">
            <thead><tr><th>유입원</th><th>주문 수</th><th>매출 합계</th></tr></thead>
            <tbody>
              <% @traffic_summaries[by].each do |value, count, revenue| %>
                <tr>
                  <td><%= by == :character ? (value ? @traffic_characters.fetch(value, "삭제된 캐릭터") : "직접") : (value.presence || "직접") %></td>
                  <td><%= count %></td><td><%= number_to_currency(revenue, unit: "원", format: "%n%u", precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>
  <table class="w-full text-left"><thead><tr><th>주문번호</th><th>상태</th><th>유입</th><th>처리</th></tr></thead><tbody>
    <% @orders.each do |order| %>
      <tr><td><%= order.order_number %></td><td><%= order.status %></td><td>
        <%= [order.source_platform, order.source_character&.name, order.source_video_id].compact_blank.join(" · ").presence || "직접" %>
      </td><td>
        <% if order.status == "pending" %>
          <%= button_to "입금 확인", confirm_payment_admin_order_path(order), method: :patch, data: { turbo_confirm: "입금을 확인하여 결제 완료 처리하시겠습니까?" } %>
        <% end %>
      </td></tr>
    <% end %>
  </tbody></table>
</div>

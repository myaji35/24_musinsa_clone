<div class="max-w-[400px] md:max-w-3xl mx-auto px-gutter py-8 md:py-12">
  <nav aria-label="내 계정" class="flex gap-4 text-ui mb-6">
    <%= link_to "내 정보", my_path %>
    <%= link_to "내 주문", my_orders_path %>
  </nav>
  <h1 class="text-title font-semibold mb-6">내 주문</h1>
  <% if @orders.any? %>
    <ul class="md:hidden text-ui mb-6">
      <% @orders.each do |order| %>
        <li class="border-b border-hairline py-4">
          <p class="font-medium"><%= order.product.name %></p>
          <p><%= order.variant.color %> / <%= order.variant.size %> · 수량 <%= order.quantity %></p>
          <p class="flex justify-between">
            <span><%= price_won(order.total_price) %></span>
            <span><%= order.status_label %></span>
          </p>
          <p class="text-caption text-ink-2"><%= order.order_number %> · <%= order.created_at.strftime("%Y.%m.%d") %></p>
        </li>
      <% end %>
    </ul>
    <div class="hidden md:block overflow-x-auto mb-6">
      <table class="w-full text-ui">
        <thead>
          <tr>
            <th scope="col">주문번호</th>
            <th scope="col">상품명</th>
            <th scope="col">옵션 색/사이즈</th>
            <th scope="col">수량</th>
            <th scope="col">금액</th>
            <th scope="col">상태</th>
            <th scope="col">주문일</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td><%= order.order_number %></td>
              <td><%= order.product.name %></td>
              <td><%= order.variant.color %> / <%= order.variant.size %></td>
              <td><%= order.quantity %></td>
              <td><%= price_won(order.total_price) %></td>
              <td><%= order.status_label %></td>
              <td><%= order.created_at.strftime("%Y.%m.%d") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-ui mb-4">아직 회원으로 주문한 내역이 없습니다. 로그인 전에 한 주문은 주문조회에서 확인하세요.</p>
    <p class="text-ui mb-6"><%= link_to "주문조회", orders_lookup_path %></p>
  <% end %>
  <%= button_to "로그아웃", logout_path, method: :delete, class: "btn btn-primary w-full" %>
</div>

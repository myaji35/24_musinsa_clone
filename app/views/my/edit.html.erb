<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <nav aria-label="내 계정" class="flex gap-4 text-ui mb-6">
    <%= link_to "내 정보", my_path, class: "tap" %>
    <%= link_to "내 주문", my_orders_path, class: "tap" %>
  </nav>
  <h1 class="text-title font-semibold mb-6">이름 수정</h1>
  <% if @user.errors.any? %>
    <ul role="alert" class="text-ui mb-6">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: @user, url: my_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, "이름", class: "block text-ui font-medium mb-2" %>
      <%= form.text_field :name, required: true, autocomplete: "name", class: "field" %>
    </div>
    <%= form.submit "저장", class: "btn btn-primary w-full" %>
  <% end %>
</div>

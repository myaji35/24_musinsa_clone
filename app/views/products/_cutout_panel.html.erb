<% latest = product.image_processings.cutouts.order(:id).last %>
<% status_labels = { "pending" => "대기 중", "processing" => "처리 중", "succeeded" => "완료", "failed" => "실패", "skipped" => "건너뜀" } %>
<% status_classes = { "pending" => "bg-gray-100 text-gray-800", "processing" => "bg-blue-100 text-blue-800", "succeeded" => "bg-green-100 text-green-800", "failed" => "bg-red-100 text-red-800", "skipped" => "bg-yellow-100 text-yellow-800" } %>
<%= turbo_frame_tag "cutout_panel" do %>
  <section id="cutout" aria-label="배경 제거" class="mt-8 bg-white border border-gray-200 rounded-lg p-6 space-y-4">
    <div class="flex flex-wrap justify-between items-center gap-3">
      <h2 class="text-lg font-bold text-gray-900">배경 제거(누끼)</h2>
      <% if latest %>
        <span data-testid="cutout-status" class="px-2 py-1 rounded text-xs font-medium <%= status_classes[latest.status] %>"><%= status_labels[latest.status] %></span>
      <% end %>
    </div>

    <% if latest&.in_progress? %>
      <div data-controller="frame-poll" data-frame-poll-url-value="<%= product_cutout_path(product) %>">
        <p class="text-sm text-gray-600">배경을 지우는 중입니다. 이미지 한 장에 몇 초에서 1분 정도 걸립니다.</p>
      </div>
    <% elsif latest&.status.in?(%w[failed skipped]) %>
      <p class="text-sm text-red-700 break-words">사유: <%= latest.error_message.presence || "알 수 없음" %></p>
    <% end %>

    <% if product.image.attached? %>
      <div class="grid grid-cols-2 gap-4">
        <figure class="space-y-2">
          <div class="aspect-square border border-gray-200 rounded-md overflow-hidden bg-gray-50">
            <%= image_tag product.image, alt: "#{product.name} 원본", class: "w-full h-full object-contain" %>
          </div>
          <figcaption class="text-sm text-gray-700">원본 <% unless product.cutout_adopted? && product.cutout_image.attached? %><span class="ml-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-900 text-white">대표</span><% end %></figcaption>
        </figure>
        <figure class="space-y-2">
          <div class="aspect-square border border-gray-200 rounded-md overflow-hidden"
               style="background-color:#fff;background-image:linear-gradient(45deg,#e5e7eb 25%,transparent 25%,transparent 75%,#e5e7eb 75%),linear-gradient(45deg,#e5e7eb 25%,transparent 25%,transparent 75%,#e5e7eb 75%);background-size:16px 16px;background-position:0 0,8px 8px;">
            <% if product.cutout_image.attached? %>
              <%= image_tag product.cutout_image, alt: "#{product.name} 누끼", class: "w-full h-full object-contain" %>
            <% else %>
              <p class="h-full flex items-center justify-center text-sm text-gray-600 bg-white/80">아직 누끼 이미지가 없습니다</p>
            <% end %>
          </div>
          <figcaption class="text-sm text-gray-700">누끼 <% if product.cutout_adopted? && product.cutout_image.attached? %><span class="ml-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-900 text-white">대표</span><% end %></figcaption>
        </figure>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= button_to (product.cutout_image.attached? ? "배경 다시 제거" : "배경 제거"), product_cutout_path(product),
            method: :post, disabled: latest&.in_progress?,
            class: "bg-black text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed" %>
        <% if product.cutout_image.attached? %>
          <% if product.cutout_adopted? %>
            <%= button_to "원본을 대표 이미지로", product_cutout_path(product), method: :patch, params: { adopted: false },
                class: "border border-gray-300 text-gray-900 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50" %>
          <% else %>
            <%= button_to "누끼를 대표 이미지로", product_cutout_path(product), method: :patch, params: { adopted: true },
                class: "border border-gray-300 text-gray-900 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-600">원본 이미지를 업로드하면 배경을 지울 수 있습니다.</p>
    <% end %>
  </section>
<% end %>

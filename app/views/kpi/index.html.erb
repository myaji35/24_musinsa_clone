<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4">KPI</h1>
  <p class="rounded border border-gray-200 bg-white p-4 mb-5">목표는 임시 가정값 기반(config/kpi_assumptions.yml) — 실측 아님</p>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <% { "목표 매출" => won(@target), "실적 매출" => won(@actual), "달성률" => percent(@achievement), "누적 분석 비용 USD" => "$#{@cost}" }.each do |label, value| %><div class="rounded-lg border border-gray-200 bg-white p-4"><p class="text-sm text-gray-500"><%= label %></p><p class="text-xl font-bold"><%= value %></p></div><% end %>
  </div>
  <div class="flex gap-3 mb-6"><% %w[done failed pending running].each do |status| %><div class="rounded-lg border border-gray-200 bg-white p-3"><%= analysis_badge(status) %> <%= @status_counts.fetch(status, 0) %></div><% end %></div>
  <% [["캐릭터별", @character_totals], ["컨셉 앵글별", @concept_totals]].each do |title, totals| %>
    <h2 class="text-lg font-bold mb-2"><%= title %></h2>
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white mb-6"><table class="w-full text-sm text-left"><thead class="bg-gray-50"><tr><th class="p-3">이름</th><th class="p-3">배정 상품 수</th><th class="p-3">목표 합</th><th class="p-3">실적 합</th><th class="p-3">달성률</th></tr></thead><tbody><% totals.each do |total| %><tr class="border-t border-gray-200"><td class="p-3"><%= total[:label].is_a?(Character) ? "#{total[:label].name} (@#{total[:label].handle})" : total[:label] %></td><td class="p-3"><%= total[:products] %></td><td class="p-3"><%= won(total[:target]) %></td><td class="p-3"><%= won(total[:actual]) %></td><td class="p-3"><%= percent(total[:achievement]) %></td></tr><% end %></tbody></table></div>
  <% end %>
  <h2 class="text-lg font-bold mb-2">상품별</h2>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white"><table class="w-full text-sm text-left"><thead class="bg-gray-50"><tr><th class="p-3">상품</th><th class="p-3">목표</th><th class="p-3">실적</th><th class="p-3">달성률</th></tr></thead><tbody><% @rows.each do |row| %><tr class="border-t border-gray-200"><td class="p-3"><%= row.product.name %></td><td class="p-3"><%= won(row.target_revenue) %></td><td class="p-3"><%= won(row.actual_revenue) %></td><td class="p-3"><%= percent(row.achievement) %></td></tr><% end %></tbody></table></div>
</div>

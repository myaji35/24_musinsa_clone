<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" data-nested-form-target="item">
  <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
    <!-- 색상 -->
    <div>
      <%= form.label :color, "색상 *", class: "block text-xs font-medium text-gray-700 mb-1" %>
      <%= form.text_field :color, required: true, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-black focus:border-black", placeholder: "예: 블랙" %>
    </div>

    <!-- 사이즈 -->
    <div>
      <%= form.label :size, "사이즈 *", class: "block text-xs font-medium text-gray-700 mb-1" %>
      <%= form.text_field :size, required: true, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-black focus:border-black", placeholder: "예: M" %>
    </div>

    <!-- 재고 -->
    <div>
      <%= form.label :stock, "현재고", class: "block text-xs font-medium text-gray-700 mb-1" %>
      <%= form.number_field :stock, min: 0, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-black focus:border-black", placeholder: "100" %>
    </div>

    <!-- 적정재고 -->
    <div>
      <%= form.label :min_stock, "적정재고", class: "block text-xs font-medium text-gray-700 mb-1" %>
      <%= form.number_field :min_stock, min: 0, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-black focus:border-black", placeholder: "10" %>
    </div>

    <!-- 삭제 버튼 -->
    <div class="flex items-end">
      <%= link_to "#", data: { action: "click->nested-form#remove" }, class: "w-full bg-red-50 text-red-600 text-sm font-medium px-3 py-2 rounded-md hover:bg-red-100 transition-colors text-center border border-red-200" do %>
        삭제
      <% end %>
    </div>
  </div>

  <!-- 바코드 정보 (읽기 전용) -->
  <% if form.object.persisted? %>
    <div class="mt-3 pt-3 border-t border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <span class="text-xs font-medium text-gray-500">바코드:</span>
          <span class="ml-2 text-xs font-mono text-gray-900"><%= form.object.barcode || "자동 생성됨" %></span>
        </div>
        <div>
          <span class="text-xs font-medium text-gray-500">SKU 코드:</span>
          <span class="ml-2 text-xs font-mono text-gray-900"><%= form.object.sku_code || "자동 생성됨" %></span>
        </div>
      </div>

      <!-- 재고 경고 -->
      <% if form.object.low_stock? %>
        <div class="mt-2 flex items-center gap-2 text-xs text-orange-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="font-medium">재고 부족 경고 (현재: <%= form.object.stock %> / 적정: <%= form.object.min_stock %>)</span>
        </div>
      <% end %>

      <% if form.object.out_of_stock? %>
        <div class="mt-2 flex items-center gap-2 text-xs text-red-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span class="font-bold">품절</span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form.hidden_field :_destroy %>
</div>

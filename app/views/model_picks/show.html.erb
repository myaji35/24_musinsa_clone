<div class="max-w-5xl mx-auto p-6 space-y-6">
  <h1 class="text-2xl font-bold"><%= @product.name %> 모델 선택</h1>
  <% if @rows.empty? %>
    <p class="p-6 border border-gray-200 text-gray-600">아직 올라온 컷 이미지가 없습니다 — 로컬 워커가 컷을 올리면 여기에 표시됩니다</p>
  <% end %>
  <% @rows.each do |row| %>
    <section class="border border-gray-200 p-6 space-y-4" aria-label="<%= row[:character].name %>">
      <h2 class="text-lg font-bold">
        <%= "#{row[:rank]}위 · " if row[:rank] %><%= row[:character].name %>
        <% if @analysis&.picked_character_id == row[:character].id %>
          <span class="bg-black text-white px-3 py-1 text-sm">선택됨</span>
        <% end %>
      </h2>
      <% if row[:reason].present? %><p class="text-gray-600"><%= row[:reason] %></p><% end %>
      <div class="grid grid-cols-3 gap-4">
        <% (1..3).each do |slot| %>
          <% if (upload = row[:uploads][slot]) %>
            <%= image_tag upload.file, alt: "#{row[:character].name} 컷 #{slot}", class: "w-full aspect-square object-cover" %>
          <% else %>
            <p class="bg-gray-100 p-4">컷 <%= slot %> 업로드 대기</p>
          <% end %>
        <% end %>
      </div>
      <%= button_to "이 모델로 선택", product_model_pick_path(@product), params: { character_id: row[:character].id }, class: "bg-black text-white px-5 py-3 font-bold" %>
    </section>
  <% end %>
</div>

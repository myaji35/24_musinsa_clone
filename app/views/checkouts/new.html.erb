<div class="max-w-[720px] mx-auto px-gutter py-8 md:py-12 space-y-6">
  <p class="font-display text-eyebrow tracking-eyebrow uppercase">CHECKOUT</p>
  <h1 class="text-title font-semibold"><%= logged_in? && current_user.member? ? "주문서" : "비회원 주문서" %></h1>
  <% if @errors.present? %>
    <div role="alert" class="border border-sale text-sale px-4 py-3 text-body"><%= @errors.join(" / ") %></div>
  <% end %>
  <ul class="border-y border-line divide-y divide-hairline">
    <% @cart.items.each do |item| %>
      <li class="p-4 flex gap-4 items-start text-ui">
        <%= render "shared/product_thumb", product: item.product, size: :sm %>
        <span class="min-w-0 flex-1"><span class="text-ui font-medium"><%= item.product.name %></span><br><%= item.variant.color %> / <%= item.variant.size %> · <%= item.quantity %>개</span>
        <span class="shrink-0"><%= price_won(item.line_total) %></span>
      </li>
    <% end %>
  </ul>
  <p class="flex justify-between border-t border-line pt-4 text-ui font-medium">주문 합계 <%= price_won(@cart.total, variant: :lg) %></p>
  <%= form_with scope: :checkout, url: checkout_path, class: "space-y-4" do |f| %>
    <h2 class="text-ui font-semibold pt-2">배송 정보</h2>
    <% { recipient_name: ["받는 분", { autocomplete: "shipping name" }],
         phone: ["휴대폰", { type: "tel", autocomplete: "shipping tel", inputmode: "tel", placeholder: "010-1234-5678" }],
         postal_code: ["우편번호", { autocomplete: "shipping postal-code", inputmode: "numeric", maxlength: 5, pattern: "[0-9]{5}", placeholder: "5자리 숫자" }],
         address1: ["주소", { autocomplete: "shipping address-line1", placeholder: "도로명 또는 지번 주소" }],
         address2: ["상세주소", { autocomplete: "shipping address-line2", placeholder: "동·호수 등 (선택)" }],
         birth_year: ["출생연도(선택)", { autocomplete: "bday-year", inputmode: "numeric", maxlength: 4, placeholder: "예: 1985" }] }.each do |field, (label, options)| %>
      <div>
        <%= f.label field, label, class: "block text-ui font-medium mb-2" %>
        <%= f.text_field field, value: @checkout[field.to_s], required: ![:address2, :birth_year].include?(field), class: "field", inputmode: "text", **options %>
      </div>
    <% end %>
    <p class="text-caption text-ink-3">출생연도는 익명 취향분석용이며 입력하지 않아도 주문할 수 있습니다.</p>
    <label class="flex items-start gap-3 py-2 min-h-11 cursor-pointer">
      <%= f.check_box :privacy_consent, checked: @checkout["privacy_consent"] == "1", class: "mt-1 h-5 w-5 shrink-0" %>
      <span class="text-body leading-relaxed">개인정보 수집·이용 동의(배송 목적. 다음 주문용 저장 주소는 배송 완료 <%= Rails.configuration.x.shipping_address_retention_days %>일 뒤 파기, 주문 기록의 배송 정보는 전자상거래법에 따라 <%= Rails.configuration.x.order_record_retention_years %>년 보관 뒤 파기)</span>
    </label>
    <%= link_to "개인정보처리방침 보기", privacy_policy_path, target: "_blank", rel: "noopener", class: "inline-block btn-text text-caption" %>
    <% instruction = PaymentInstruction.new %>
    <p class="text-caption text-ink-3" data-testid="checkout-payment-note">
      <% if instruction.ready? %>
        결제는 주문 후 계좌이체로 진행됩니다(주문 완료 화면에서 입금 계좌 안내)
      <% else %>
        결제는 주문 후 계좌이체로 진행됩니다. 입금 계좌는 준비 중이며, <%= logged_in? && current_user.member? ? "준비되면 내 주문에서 확인하실 수 있습니다." : "준비되면 주문조회(주문서 번호 + 휴대폰 뒤 4자리)에서 확인하실 수 있습니다." %>
      <% end %>
    </p>
    <% business = BusinessInfo.new %>
    <section class="border border-hairline p-4 space-y-3 text-sm leading-relaxed text-ink-2" aria-label="주문 전 확인">
      <h2 class="font-bold text-ink">주문 전 확인</h2>
      <p>청약철회: 상품 수령 후 7일 이내에 판매자 연락처로 요청할 수 있습니다. 택 제거·착용으로 상품 가치가 크게 줄어든 경우에는 청약철회가 제한될 수 있습니다. 내용 확인을 위한 포장 훼손만으로 제한하지 않습니다.</p>
      <p>표시·광고 또는 계약과 다른 상품은 수령 후 3개월 이내이면서 그 사실을 안 날 또는 알 수 있었던 날부터 30일 이내에 청약철회를 요청할 수 있습니다.</p>
      <p>환불: 반품 도착 후 3영업일 이내에 입금 계좌로 환급합니다. 단순 변심 반품 배송비는 고객 부담이며, 상품 하자·오배송은 판매자 부담입니다.</p>
      <p>미성년자가 법정대리인 동의 없이 체결한 계약은 미성년자 또는 법정대리인이 취소할 수 있습니다.</p>
      <p>판매자 상호: <%= business.name || "등록 준비 중" %> · 전화: <%= business.phone || "등록 준비 중" %> · 이메일: <%= business.email || "등록 준비 중" %></p>
      <nav class="flex flex-wrap gap-4" aria-label="주문 관련 정책">
        <%= link_to "배송·반품 안내", returns_policy_path, class: "underline" %>
        <%= link_to "이용약관", terms_policy_path, class: "underline" %>
        <%= link_to "개인정보처리방침", privacy_policy_path, class: "underline" %>
      </nav>
    </section>
    <%= f.submit "주문하기", class: "btn btn-primary w-full" %>
  <% end %>
</div>

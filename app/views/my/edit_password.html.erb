<div class="max-w-[400px] mx-auto px-gutter py-8 md:py-12">
  <nav aria-label="내 계정" class="flex gap-4 text-ui mb-6">
    <%= link_to "내 정보", my_path, class: "tap" %>
    <%= link_to "내 주문", my_orders_path, class: "tap" %>
  </nav>
  <h1 class="text-title font-semibold mb-6">비밀번호 변경</h1>
  <% if @user&.errors&.any? %>
    <ul role="alert" class="text-ui mb-6">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with scope: :password_change, url: my_password_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :current_password, "현재 비밀번호", class: "block text-ui font-medium mb-2" %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "field" %>
    </div>
    <div>
      <%= form.label :password, "새 비밀번호", class: "block text-ui font-medium mb-2" %>
      <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "field" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "새 비밀번호 확인", class: "block text-ui font-medium mb-2" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "field" %>
    </div>
    <%= form.submit "비밀번호 변경", class: "btn btn-primary w-full" %>
  <% end %>
</div>

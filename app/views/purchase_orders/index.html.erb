<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">발주서 관리</h1>
    <%= link_to "발주서 생성", new_purchase_order_path, class: "bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg" %>
  </div>

  <% if @purchase_orders.any? %>
    <div class="hidden lg:block bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">발주번호</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">거래처</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">상태</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">총액</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">납품 예정일</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">등록일</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">작업</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @purchase_orders.each do |po| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to po.order_number, purchase_order_path(po), class: "text-blue-600 hover:text-blue-800 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.supplier.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_class = case po.status
                  when "draft" then "bg-gray-100 text-gray-800"
                  when "submitted" then "bg-yellow-100 text-yellow-800"
                  when "confirmed" then "bg-blue-100 text-blue-800"
                  when "received" then "bg-green-100 text-green-800"
                  when "cancelled" then "bg-red-100 text-red-800"
                  end %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                  <%= po.status_label %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= admin_krw(po.total_amount) %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= po.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex items-center gap-2">
                <%= link_to "상세", purchase_order_path(po), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <% if po.status == "draft" %>
                  <%= link_to "수정", edit_purchase_order_path(po), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                  <% if mall_admin? %>
                    <%= button_to "취소", purchase_order_path(po), method: :delete, form: { data: { turbo_confirm: "정말 취소하시겠습니까?" } }, class: "text-red-600 hover:text-red-900" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <ul class="lg:hidden space-y-4">
      <% @purchase_orders.each do |po| %>
        <li class="bg-white rounded-lg shadow border border-gray-200 p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 break-words">
              <%= link_to po.order_number, purchase_order_path(po), class: "text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
            <div class="shrink-0">
              <% status_class = case po.status
                when "draft" then "bg-gray-100 text-gray-800"
                when "submitted" then "bg-yellow-100 text-yellow-800"
                when "confirmed" then "bg-blue-100 text-blue-800"
                when "received" then "bg-green-100 text-green-800"
                when "cancelled" then "bg-red-100 text-red-800"
                end %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                <%= po.status_label %>
              </span>
            </div>
          </div>
          <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
            <dt class="text-gray-500">거래처</dt>
            <dd class="min-w-0 break-words"><%= po.supplier.name %></dd>
            <dt class="text-gray-500">총액</dt>
            <dd class="min-w-0 break-words"><%= admin_krw(po.total_amount) %></dd>
            <dt class="text-gray-500">납품 예정일</dt>
            <dd class="min-w-0 break-words"><%= po.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></dd>
            <dt class="text-gray-500">등록일</dt>
            <dd class="min-w-0 break-words"><%= po.created_at.strftime("%Y-%m-%d") %></dd>
          </dl>
          <div class="flex flex-wrap gap-2 text-sm font-medium">
            <%= link_to "상세", purchase_order_path(po), class: "text-indigo-600 hover:text-indigo-900 mr-3 min-h-11 inline-flex items-center px-3" %>
            <% if po.status == "draft" %>
              <%= link_to "수정", edit_purchase_order_path(po), class: "text-blue-600 hover:text-blue-900 mr-3 min-h-11 inline-flex items-center px-3" %>
              <% if mall_admin? %>
                <%= button_to "취소", purchase_order_path(po), method: :delete, form: { data: { turbo_confirm: "정말 취소하시겠습니까?" } }, class: "text-red-600 hover:text-red-900 min-h-11 inline-flex items-center px-3" %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
      등록된 발주서가 없습니다. 새로운 발주서를 생성해주세요.
    </div>
  <% end %>
</div>

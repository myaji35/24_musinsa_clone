<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold"><%= @supplier.name %></h1>
    <div>
      <%= link_to "수정", edit_supplier_path(@supplier), class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg mr-2" %>
      <%= link_to "목록", suppliers_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-bold mb-4">거래처 정보</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-sm text-gray-600">담당자</p>
        <p class="font-medium"><%= @supplier.contact_person || "-" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-600">전화번호</p>
        <p class="font-medium"><%= @supplier.phone %></p>
      </div>

      <div>
        <p class="text-sm text-gray-600">이메일</p>
        <p class="font-medium"><%= @supplier.email || "-" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-600">결제 조건</p>
        <p class="font-medium"><%= @supplier.payment_terms || "-" %></p>
      </div>

      <div class="col-span-2">
        <p class="text-sm text-gray-600">주소</p>
        <p class="font-medium"><%= @supplier.address || "-" %></p>
      </div>

      <div class="col-span-2">
        <p class="text-sm text-gray-600">메모</p>
        <p class="font-medium"><%= @supplier.notes || "-" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-600">상태</p>
        <% if @supplier.active %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">활성</span>
        <% else %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">비활성</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold">최근 발주 내역</h2>
      <%= link_to "발주서 작성", new_purchase_order_path(supplier_id: @supplier.id), class: "bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm" %>
    </div>

    <% if @purchase_orders.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">발주번호</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">상태</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">금액</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">입고 예정일</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">등록일</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">관리</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @purchase_orders.each do |po| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to po.order_number, purchase_order_path(po), class: "text-blue-600 hover:text-blue-800 font-medium" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% status_class = case po.status
                    when "draft" then "bg-gray-100 text-gray-800"
                    when "submitted" then "bg-yellow-100 text-yellow-800"
                    when "confirmed" then "bg-blue-100 text-blue-800"
                    when "received" then "bg-green-100 text-green-800"
                    when "cancelled" then "bg-red-100 text-red-800"
                    end %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                    <%= po.status %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">₩<%= number_with_delimiter(po.total_amount) %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= po.expected_delivery_date&.strftime("%Y-%m-%d") || "-" %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= po.created_at.strftime("%Y-%m-%d") %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to "상세", purchase_order_path(po), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">아직 발주 내역이 없습니다.</p>
    <% end %>
  </div>
</div>

<div class="max-w-5xl mx-auto p-6">
  <h1 class="text-2xl md:text-3xl font-bold">주문 관리</h1>

  <section class="my-6 rounded-lg bg-yellow-50 border border-yellow-200 p-4" aria-labelledby="pending-orders-heading">
    <h2 id="pending-orders-heading" class="font-bold">처리할 주문</h2>
    <% if @pending_count.zero? %>
      <p class="mt-2">지금 처리할 주문이 없습니다</p>
    <% else %>
      <p class="mt-2">입금 대기 <strong class="text-2xl"><%= @pending_count %>건</strong></p>
    <% end %>
  </section>

  <nav class="flex gap-2 mb-6 overflow-x-auto whitespace-nowrap md:flex-wrap" aria-label="주문 상태 필터">
    <%= link_to "전체", admin_orders_path, class: "chip#{' font-bold' unless @selected_status}", aria: { current: ("page" unless @selected_status) } %>
    <% @order_statuses.each do |status| %>
      <%= link_to order_status_label(status), admin_orders_path(status: status), class: "chip#{' font-bold' if @selected_status == status}", aria: { current: ("page" if @selected_status == status) } %>
    <% end %>
  </nav>

  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left">
      <thead><tr>
        <% ["주문번호", "주문일", "금액", "상태", "유입", "처리"].each do |heading| %>
          <th scope="col" class="p-3 border-b"><%= heading %></th>
        <% end %>
      </tr></thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr class="border-b <%= 'bg-yellow-50' if order.status == 'pending' %>">
            <td class="p-3"><%= order.order_number %></td>
            <td class="p-3"><%= seoul_datetime(order.created_at) %></td>
            <td class="p-3"><%= number_with_delimiter(order.total_price.to_i) %>원</td>
            <td class="p-3"><span class="rounded-full px-2 py-1 text-sm font-semibold <%= order_status_badge_class(order.status) %>"><%= order_status_label(order.status) %></span></td>
            <td class="p-3"><%= [order.source_platform, order.source_character&.name, order.source_video_id].compact_blank.join(" · ").presence || "직접" %></td>
            <td class="p-3">
              <% if order.status == "pending" %>
                <%= button_to "입금 확인", confirm_payment_admin_order_path(order), method: :patch, data: { turbo_confirm: "입금을 확인하여 결제 완료 처리하시겠습니까?" }, class: "btn btn-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="md:hidden space-y-3">
    <% @orders.each do |order| %>
      <li class="border rounded-lg p-4 space-y-3 <%= 'bg-yellow-50' if order.status == 'pending' %>">
        <div class="flex items-center justify-between gap-3">
          <strong><%= order.order_number %></strong>
          <span class="rounded-full px-2 py-1 text-sm font-semibold <%= order_status_badge_class(order.status) %>"><%= order_status_label(order.status) %></span>
        </div>
        <p><%= seoul_datetime(order.created_at) %> · <strong><%= number_with_delimiter(order.total_price.to_i) %>원</strong></p>
        <p>유입: <%= [order.source_platform, order.source_character&.name, order.source_video_id].compact_blank.join(" · ").presence || "직접" %></p>
        <% if order.status == "pending" %>
          <%= button_to "입금 확인", confirm_payment_admin_order_path(order), method: :patch, data: { turbo_confirm: "입금을 확인하여 결제 완료 처리하시겠습니까?" }, class: "btn btn-primary w-full" %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <details class="my-6">
    <summary class="cursor-pointer text-lg font-bold">유입원별 집계 보기</summary>
    <div class="grid gap-4 md:grid-cols-3 mt-3">
      <% { platform: "플랫폼별", character: "캐릭터별", video: "영상별" }.each do |by, title| %>
        <div class="rounded border p-3">
          <h3 class="font-semibold mb-2"><%= title %></h3>
          <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead><tr><th>유입원</th><th>주문 수</th><th>매출 합계</th></tr></thead>
            <tbody>
              <% @traffic_summaries[by].each do |value, count, revenue| %>
                <tr>
                  <td><%= by == :character ? (value ? @traffic_characters.fetch(value, "삭제된 캐릭터") : "직접") : (value.presence || "직접") %></td>
                  <td><%= count %></td><td><%= number_to_currency(revenue, unit: "원", format: "%n%u", precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        </div>
      <% end %>
    </div>
  </details>
</div>

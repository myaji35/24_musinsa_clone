<%# 29cm 스타일 큐레이션 섹션 %>
<div class="mb-16">
  <%# 섹션 헤더 %>
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-black mb-2">
      <%= mood_to_title(mood) %>
    </h2>
    <p class="text-sm text-gray-500">
      <%= mood_to_description(mood) %>
    </p>

    <% if (host = mood_host(mood)) %>
      <%= link_to character_path(host.handle), class: "flex items-center gap-4 mb-6 text-black" do %>
        <% if (avatar = Avatar.find(host.handle)) %>
          <%= image_tag avatar.card_image, alt: "#{host.name} (AI 가상 인물)", loading: "lazy", class: "w-16 h-20 rounded-full object-cover shrink-0" %>
        <% end %>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="text-base font-semibold"><%= host.name %></span>
            <span class="text-[11px] text-gray-500">가상 인물</span>
          </div>
          <p class="text-sm"><%= host.name %> 스타일 — <%= host.wardrobe %></p>
          <p class="text-sm text-gray-500 mt-1"><%= host.personality %></p>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# 상품 그리드 (29cm 스타일: 모바일 2열, 데스크톱 4열) %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
    <% products.first(4).each do |product| %>
      <%= render 'products/card', product: product %>
    <% end %>
  </div>

  <%# 더보기 링크 (선택사항) %>
  <div class="text-center mt-8">
    <a href="<%= products_path %>" class="inline-block px-6 py-2 border border-gray-300 text-sm font-medium text-gray-700 hover:border-black hover:text-black transition-colors">
      더 많은 상품 보기
    </a>
  </div>
</div>

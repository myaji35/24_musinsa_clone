<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for(:title) || "JIEUM - AI Fashion OS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JIEUM">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA Manifest - Enabled for installable apps %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <%# 한글 기본 글꼴 Pretendard(필요한 글자만 내려받는 동적 서브셋) %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" crossorigin>
  </head>

  <body class="bg-white text-gray-900 font-sans antialiased" data-controller="lazy-load">
    <!-- Top Utility Bar -->
    <div class="bg-white border-b border-gray-100 hidden md:block">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-8 flex items-center justify-end space-x-4 text-xs text-gray-600 font-medium">
            <% if logged_in? %>
              <span><%= current_user.name.presence || current_user.email %></span>
              <%= button_to "로그아웃", logout_path, method: :delete, class: "hover:text-black" %>
            <% else %>
              <%= link_to "로그인", login_path, class: "hover:text-black" %>
            <% end %>
            <a href="#" class="hover:text-black">회원가입</a>
            <%= link_to "주문조회", orders_lookup_path, class: "hover:text-black" %>
            <%= link_to "장바구니 (#{cart_count})", cart_path, class: "hover:text-black" %>
            <a href="#" class="hover:text-black">고객센터</a>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="bg-white sticky top-0 z-50 shadow-sm border-b border-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 md:h-20 flex items-center justify-between gap-4 md:gap-8">
        <!-- Logo -->
        <a href="/" class="text-2xl md:text-3xl font-bold tracking-tighter shrink-0 font-oswald italic pr-2">JIEUM</a>
        
        <!-- Search Bar (Hidden on mobile, visible on desktop) -->
        <div class="hidden md:flex flex-1 max-w-xl mx-auto relative">
            <%= form_with url: root_path, method: :get, local: true, class: "w-full" do |f| %>
                <%= f.text_field :q, value: params[:q], placeholder: "검색어를 입력하세요", class: "w-full h-10 pl-4 pr-12 bg-gray-100 border-none rounded-sm text-sm focus:ring-1 focus:ring-black placeholder-gray-600 font-medium" %>
                <button type="submit" aria-label="검색" class="absolute right-1 p-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black">
                   <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
            <% end %>
        </div>

        <!-- Navigation Links -->
        <div aria-label="데스크톱 메뉴" class="hidden md:flex items-center space-x-6 md:space-x-8 font-bold text-sm md:text-[15px] tracking-tight whitespace-nowrap">
          <a href="/" class="hover:text-gray-500 hover:underline underline-offset-4 decoration-2">랭킹</a>
          <a href="/products" class="hover:text-gray-500">상품</a>
          <a href="/snaps" class="hover:text-gray-500">매거진</a>
          <% if logged_in? %>
            <%= link_to "재고관리", inventory_scan_path, class: "hover:text-gray-500" %>
            <%= link_to "대시보드", dashboard_index_path, class: "hover:text-gray-500 text-blue-600" %>
            <%= link_to "거래처", suppliers_path, class: "hover:text-gray-500 text-purple-600" %>
            <%= link_to "발주", purchase_orders_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "상품 입고(엑셀)", supplier_imports_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "상품분석", product_analyses_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "트렌드", trends_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "KPI", kpi_path, class: "hover:text-gray-500 text-green-600" %>
          <% end %>
        </div>

        <!-- Mobile Menu & Icons -->
        <div class="flex items-center space-x-3 md:space-x-5 shrink-0">
          <a href="<%= cart_path %>" aria-label="장바구니" class="relative hover:text-gray-500">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
             <% if cart_count.positive? %>
               <span class="absolute -top-1 -right-1 bg-red-600 text-white text-[11px] leading-4 font-bold px-1 rounded-full tabular-nums"><%= cart_count %></span>
             <% end %>
          </a>
          <a href="<%= orders_lookup_path %>" aria-label="주문조회" class="hover:text-gray-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </a>
        </div>
      </div>
      <% if logged_in? %>
        <div aria-label="모바일 관리자 메뉴" class="md:hidden flex items-center gap-5 overflow-x-auto whitespace-nowrap px-4 py-3 text-sm font-bold border-t border-gray-100">
          <%= link_to "재고관리", inventory_scan_path, class: "hover:text-gray-500" %>
          <%= link_to "대시보드", dashboard_index_path, class: "hover:text-gray-500 text-blue-600" %>
          <%= link_to "거래처", suppliers_path, class: "hover:text-gray-500 text-purple-600" %>
          <%= link_to "발주", purchase_orders_path, class: "hover:text-gray-500 text-green-600" %>
          <%= link_to "상품 입고(엑셀)", supplier_imports_path, class: "hover:text-gray-500 text-green-600" %>
          <%= link_to "상품분석", product_analyses_path, class: "hover:text-gray-500 text-green-600" %>
          <%= link_to "트렌드", trends_path, class: "hover:text-gray-500 text-green-600" %>
          <%= link_to "KPI", kpi_path, class: "hover:text-gray-500 text-green-600" %>
        </div>
      <% end %>
    </nav>
    
    <!-- Secondary Category Nav (Visual) -->
    <div class="border-b border-gray-200 bg-white hidden md:block">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-10 flex items-center space-x-6 text-xs font-bold text-gray-700 overflow-x-auto">
             <%= link_to "전체", root_path(anchor: "ranking"), class: (params[:category].blank? && current_page?(root_path) ? "text-black" : "hover:text-black") %>
             <% shop_categories.map(&:first).each do |name| %>
               <%= link_to name, root_path(category: name, anchor: "ranking"), class: (params[:category] == name ? "text-black" : "hover:text-black"), aria: { current: (params[:category] == name ? "page" : nil) } %>
             <% end %>
         </div>
    </div>

    <main>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-3">
          <% if flash[:notice].present? %>
            <div role="status" class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm leading-relaxed">
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert].present? %>
            <div role="alert" class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm leading-relaxed">
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    
    <footer class="bg-gray-100 border-t border-gray-200 pt-16 pb-20 mt-20 text-xs text-gray-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
                <div class="col-span-1 md:col-span-2">
                    <h3 class="text-2xl font-bold text-black mb-4 font-oswald italic">JIEUM</h3>
                    <p class="leading-relaxed mb-4">
                        "2027 겨울, 가장 먼저 입어보세요"<br>
                        AI-Native Fashion Operating System<br>
                        Privacy-First CRM · UCP Protocol · Barcode Automation<br>
                        Built with Rails 8.1 + Claude AI
                    </p>
                    <p class="text-[11px] text-gray-500 mb-4">사이트의 모델 이미지는 AI로 생성되었으며, 의류는 실제 판매 상품입니다.</p>
                    <div class="flex space-x-3">
                        <a href="#" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition-colors">F</a>
                        <a href="#" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition-colors">I</a>
                        <a href="#" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition-colors">Y</a>
                    </div>
                </div>
                <div>
                   <h4 class="font-bold text-black mb-3">HELP</h4>
                   <ul class="space-y-3">
                       <li><a href="#" class="inline-block py-1 hover:underline">공지사항</a></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">자주 묻는 질문</a></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">1:1 문의</a></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">비회원 주문조회</a></li>
                   </ul>
                </div>
                <div>
                   <h4 class="font-bold text-black mb-3">POLICY</h4>
                   <ul class="space-y-3">
                       <li><a href="#" class="inline-block py-1 hover:underline text-black font-bold">개인정보처리방침</a></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">이용약관</a></li>
                       <li><%= link_to "배송·반품 안내", returns_policy_path, class: "inline-block py-1 hover:underline" %></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">입점신청</a></li>
                       <li><a href="#" class="inline-block py-1 hover:underline">채용안내</a></li>
                   </ul>
                </div>
            </div>
            <div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-600">
                <p>🤖 Generated with <a href="https://claude.com/claude-code" class="underline hover:text-black">Claude Code</a> · COPYRIGHT (C) 2026 JIEUM ALL RIGHTS RESERVED.</p>
                <div class="flex space-x-2 mt-2 md:mt-0">
                    <span>Rails 8.1 · Solid Queue · Tailwind CSS</span>
                </div>
            </div>
        </div>
    </footer>
  </body>
</html>

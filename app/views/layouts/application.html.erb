<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for(:title) || "JIEUM - AI Fashion OS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JIEUM">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA Manifest - Enabled for installable apps %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <%# 한글 기본 글꼴 Pretendard(필요한 글자만 내려받는 동적 서브셋) %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" crossorigin>
  </head>

  <body class="bg-paper text-ink font-sans antialiased" data-controller="lazy-load">
    <div class="relative h-8 md:h-band bg-ink text-inverse text-caption flex items-center justify-center px-gutter">
      <p>전 상품 무료배송 · 7일 내 반품</p>
      <nav class="absolute right-gutter hidden md:flex items-center gap-4" aria-label="계정 메뉴">
            <% if logged_in? %>
              <span><%= current_user.name.presence || current_user.email %></span>
              <%= link_to "내 워크스페이스", workspace_path, class: "hover:underline" unless mall_admin? %>
              <%= button_to "로그아웃", logout_path, method: :delete, class: "hover:underline" %>
            <% else %>
              <%= link_to "로그인", login_path, class: "hover:underline" %>
            <% end %>
            <%= link_to "주문조회", orders_lookup_path, class: "hover:underline" %>
            <%= link_to "장바구니 (#{cart_count})", cart_path, class: "hover:underline" %>
      </nav>
    </div>
    <header class="sticky top-0 z-50 bg-paper border-b border-line h-header-m md:h-header px-gutter grid grid-cols-[1fr_auto_1fr] items-center">
      <div class="flex items-center gap-4">
        <details name="header-panel" class="menu">
          <summary class="text-ui font-medium list-none cursor-pointer h-chip inline-flex items-center">메뉴</summary>
          <div class="absolute left-0 right-0 top-full bg-scrim border-b border-line px-gutter py-6">
            <div class="md:hidden mb-4">
              <%= form_with url: root_path, method: :get, local: true, class: "flex items-center gap-2 w-full" do |f| %>
                  <%= f.text_field :q, value: params[:q], placeholder: "검색어를 입력하세요", aria: { label: "검색어" }, class: "field h-11 border-0 border-b border-line" %>
                  <button type="submit" class="sym text-ui font-medium shrink-0">검색</button>
                <% end %>
            </div>
            <nav aria-label="사이트 메뉴">
              <% [ [ "데스크톱 메뉴", "hidden md:flex" ], [ "모바일 메뉴", "md:hidden" ] ].each do |label, visibility| %>
                <nav aria-label="<%= label %>" class="<%= visibility %> gap-4">
                  <% menu_links = [ [ "랭킹", root_path ], [ "상품", products_path ] ] %>
                  <% menu_links << [ "매거진", magazine_path ] if magazine_available? %>
                  <% menu_links.each do |name, path| %>
                    <%= link_to name, path, class: "text-ui font-medium py-2 block#{' underline' if current_page?(path)}", aria: { current: (current_page?(path) ? "page" : nil) } %>
                  <% end %>
                </nav>
              <% end %>
              <% if mall_admin? %>
                <div aria-label="모바일 관리자 메뉴" class="md:hidden border-b border-hairline px-gutter py-2 text-caption flex flex-wrap gap-x-4 gap-y-1">
                  <%= link_to "판매현황", sales_path, class: "hover:text-gray-500" %>
                  <%= link_to "재고관리", inventory_scan_path, class: "hover:text-gray-500" %>
                  <%= link_to "대시보드", dashboard_index_path, class: "hover:text-gray-500 text-blue-600" %>
                  <%= link_to "주문 관리", admin_orders_path %>
                  <%= link_to "의견함 (#{feedback_new_count})", feedbacks_admin_index_path %>
                    <%= link_to "위챗", wechat_index_path %>
            <%= link_to "거래처", suppliers_path, class: "hover:text-gray-500 text-purple-600" %>
                  <%= link_to "발주", purchase_orders_path, class: "hover:text-gray-500 text-green-600" %>
                  <%= link_to "클레임", supplier_claims_path, class: "hover:text-gray-500" %>
                  <%= link_to "상품 입고(엑셀)", supplier_imports_path, class: "hover:text-gray-500 text-green-600" %>
                  <%= link_to "상품정보 입력", product_info_notices_path, class: "hover:text-gray-500" %>
                  <%= link_to "상품분석", product_analyses_path, class: "hover:text-gray-500 text-green-600" %>
                  <%= link_to "트렌드", trends_path, class: "hover:text-gray-500 text-green-600" %>
                  <%= link_to "KPI", kpi_path, class: "hover:text-gray-500 text-green-600" %>
                </div>
              <% end %>

            </nav>
            <ul>
              <li><%= link_to "전체", root_path, class: "text-ui font-medium py-2 block" %></li>
              <% shop_categories.map(&:first).each do |name| %>
                <li><%= link_to name, root_path(category: name, anchor: "ranking"), class: "text-ui font-medium py-2 block" %></li>
              <% end %>
              <li class="md:hidden"><%= link_to "주문조회", orders_lookup_path, class: "text-ui font-medium py-2 block" %></li>
            </ul>
          </div>
        </details>
        <details name="header-panel" class="search hidden md:block">
          <summary class="text-ui font-medium list-none cursor-pointer h-chip inline-flex items-center">검색</summary>
          <div class="absolute left-0 right-0 top-full bg-scrim border-b border-line px-gutter py-6">
            <%= form_with url: root_path, method: :get, local: true, class: "flex items-center gap-2 w-full" do |f| %>
                  <%= f.text_field :q, value: params[:q], placeholder: "검색어를 입력하세요", aria: { label: "검색어" }, class: "field h-11 border-0 border-b border-line" %>
                  <button type="submit" class="sym text-ui font-medium shrink-0">검색</button>
                <% end %>
          </div>
        </details>
      </div>
      <a href="/" class="font-display font-medium text-[18px] md:text-[22px] tracking-wordmark uppercase">JIEUM</a>
      <div class="flex items-center justify-end gap-4 text-ui font-medium whitespace-nowrap">
        <%= link_to "주문조회", orders_lookup_path, class: "hidden md:inline-flex" %>
        <a href="<%= cart_path %>" aria-label="장바구니">장바구니 (<% if cart_count.positive? %><%= cart_count %><% else %>0<% end %>)</a>
      </div>
    </header>
    <div class="h-catrow border-b border-hairline px-gutter flex items-center gap-2 overflow-x-auto">
      <%= link_to "전체", root_path(anchor: "ranking"), class: "chip", aria: { current: (params[:category].blank? && current_page?(root_path) ? "page" : nil) } %>
      <% shop_categories.map(&:first).each do |name| %>
        <%= link_to name, root_path(category: name, anchor: "ranking"), class: "chip", aria: { current: (params[:category] == name ? "page" : nil) } %>
      <% end %>
    </div>
      <% if mall_admin? %>
        <nav aria-label="관리 메뉴">
        <div aria-label="데스크톱 관리자 메뉴" class="hidden md:block">
          <div class="border-b border-hairline px-gutter py-2 text-caption flex flex-wrap gap-x-4 gap-y-1">
            <%= link_to "판매현황", sales_path, class: "hover:text-gray-500" %>
            <%= link_to "재고관리", inventory_scan_path, class: "hover:text-gray-500" %>
            <%= link_to "대시보드", dashboard_index_path, class: "hover:text-gray-500 text-blue-600" %>
            <%= link_to "주문 관리", admin_orders_path %>
            <%= link_to "의견함 (#{feedback_new_count})", feedbacks_admin_index_path %>
            <%= link_to "위챗", wechat_index_path %>
            <%= link_to "거래처", suppliers_path, class: "hover:text-gray-500 text-purple-600" %>
            <%= link_to "발주", purchase_orders_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "클레임", supplier_claims_path, class: "hover:text-gray-500" %>
            <%= link_to "상품 입고(엑셀)", supplier_imports_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "상품정보 입력", product_info_notices_path, class: "hover:text-gray-500" %>
            <%= link_to "상품분석", product_analyses_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "트렌드", trends_path, class: "hover:text-gray-500 text-green-600" %>
            <%= link_to "KPI", kpi_path, class: "hover:text-gray-500 text-green-600" %>
          </div>
        </div>
        </nav>
      <% end %>
    <main>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="px-gutter pt-6 space-y-3">
          <% if flash[:notice].present? %>
            <div role="status" class="border border-ink px-4 py-3 text-body text-notice">
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert].present? %>
            <div role="alert" class="border border-ink px-4 py-3 text-body text-sale">
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    
    <footer class="border-t border-line bg-paper px-gutter pt-12 pb-20 mt-20 text-caption text-ink-2">
        <div class="">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
                <div class="col-span-1 md:col-span-2">
                    <p class="font-display font-medium text-display tracking-wordmark uppercase mb-4">JIEUM</p>
                    <p class="text-caption text-ink-3 mb-4">
                        "2027 겨울, 가장 먼저 입어보세요"
                    </p>
                    <p class="text-caption text-ink-3 mb-4">사이트의 모델 이미지는 AI로 생성되었으며, 의류는 실제 판매 상품입니다.</p>
                </div>
                <div>
                   <h2 class="font-display text-eyebrow tracking-eyebrow uppercase text-ink-3 mb-3">HELP</h2>
                   <ul class="space-y-3">
                       <li><%= link_to "비회원 주문조회", orders_lookup_path, class: "inline-block py-1 text-ink-2 hover:text-ink" %></li>
                       <li><%= link_to "배송·반품 안내", returns_policy_path, class: "inline-block py-1 text-ink-2 hover:text-ink" %></li>
                       <li><%= link_to "의견 보내기", new_feedback_path, class: "inline-block py-1 text-ink-2 hover:text-ink" %></li>
                   </ul>
                </div>
                <div>
                   <h2 class="font-display text-eyebrow tracking-eyebrow uppercase text-ink-3 mb-3">POLICY</h2>
                   <ul class="space-y-3">
                       <li><%= link_to "개인정보처리방침", privacy_policy_path, class: "inline-block py-1 font-medium text-ink-2 hover:text-ink" %></li>
                       <li><%= link_to "이용약관", terms_policy_path, class: "inline-block py-1 font-normal text-ink-2 hover:text-ink" %></li>
                   </ul>
                </div>
            </div>
            <div class="mb-8"><%= render "shared/business_info" %></div>
            <div class="border-t border-hairline pt-6 text-center md:text-left text-caption text-ink-3">
                <p>🤖 Generated with <a href="https://claude.com/claude-code" class="underline hover:text-ink">Claude Code</a> · COPYRIGHT (C) 2026 JIEUM ALL RIGHTS RESERVED.</p>
            </div>
        </div>
    </footer>
    <%= render "shared/operator_feedback" if mall_admin? %>
  </body>
</html>

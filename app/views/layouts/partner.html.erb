<!DOCTYPE html>
<html lang="ko">
<head>
  <title>JIEUM 파트너센터</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white border-b shadow-sm">
    <div class="max-w-7xl mx-auto p-4 flex flex-wrap items-center gap-6">
      <%= link_to "JIEUM 파트너센터", partner_root_path, class: "text-xl font-bold" %>
      <% if current_supplier_account&.active? && current_supplier&.active? %>
        <span class="font-medium"><%= current_supplier.name %></span>
        <nav class="flex flex-wrap gap-4" aria-label="파트너 메뉴">
          <%= link_to "대시보드", partner_root_path %>
          <%= link_to "재고", partner_inventory_index_path %>
          <%= link_to "입고예정", partner_purchase_orders_path %>
          <%= link_to "클레임", partner_claims_path %>
        </nav>
        <%= button_to "로그아웃", partner_logout_path, method: :delete, class: "text-gray-600" %>
      <% end %>
    </div>
  </header>
  <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <% flash.each do |type, message| %>
      <p role="status" class="p-4 rounded-lg <%= type == "alert" ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800" %>"><%= message %></p>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
